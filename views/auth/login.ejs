<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Pengurus - MyMosque App</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex items-center justify-center min-h-screen font-sans">

    <!-- Efek Latar Belakang -->
    <div class="fixed inset-0 z-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-emerald-100 via-gray-50 to-gray-50 opacity-70"></div>

    <div class="w-full max-w-md p-8 relative z-10">
        
        <!-- Header Login -->
        <div class="text-center mb-4">
            <div class="inline-flex items-center justify-center w-32 h-32 text-emerald-600 overflow-hidden">
                <% if (typeof appSettings !== 'undefined' && appSettings.logo) { %>
                    <!-- Menampilkan logo dari Setting Aplikasi -->
                    <img src="/uploads/<%= appSettings.logo %>" alt="Logo Masjid" class="w-full h-full object-contain">
                <% } else { %>
                    <!-- Fallback Icon SVG bawaan jika logo belum diatur -->
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4"></path></svg>
                <% } %>
            </div>
            <h2 class="text-2xl font-extrabold text-gray-800">MyMosque App</h2>
            <p class="text-sm text-gray-500 mt-1">Sistem Informasi Manajemen Masjid</p>
        </div>

        <!-- Card Form Login -->
        <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-8">
            
            <h3 class="text-lg font-bold text-gray-800 mb-6 text-center">Masuk ke Panel Admin</h3>

            <!-- Form Eksekusi -->
            <form action="/login" method="POST" class="space-y-5">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Username</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        </div>
                        <input type="text" name="username" required class="w-full pl-10 pr-3 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all" placeholder="Masukkan username">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-2">Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                        <input type="password" name="password" required class="w-full pl-10 pr-3 py-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all" placeholder="••••••••">
                    </div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-md text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-colors">
                        Masuk Sistem &rarr;
                    </button>
                </div>
            </form>
            
        </div>
        
        <!-- Tautan Kembali -->
        <div class="text-center mt-6">
            <a href="/" class="text-sm font-medium text-emerald-600 hover:text-emerald-500 transition-colors">
                &larr; Kembali ke Beranda Publik
            </a>
        </div>

    </div>

    <!-- ========================================== -->
    <!-- MODAL POPUP NOTIFIKASI GAGAL LOGIN -->
    <!-- ========================================== -->
    <div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
            <div class="text-center">
                <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-gray-800 mb-1">Gagal Masuk</h3>
                <p id="notifMessage" class="text-sm text-gray-500 mb-6">Username atau password salah.</p>
                <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                    Coba Lagi
                </button>
            </div>
        </div>
    </div>

    <!-- Skrip Trigger Otomatis Popup Gagal Login -->
    <script>
        function showNotification(message) {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            const msg = document.getElementById('notifMessage');

            msg.innerText = message;
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeNotificationModal() {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Trigger otomatis jika backend mengirimkan error login
        <% if (typeof error !== 'undefined' && error) { %>
            showNotification('<%= error %>');
        <% } %>
    </script>
</body>
</html>