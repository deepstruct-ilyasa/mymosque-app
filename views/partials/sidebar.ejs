<div id="sidebar-overlay" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-20 hidden md:hidden" onclick="toggleSidebar()"></div>

<!-- CSS Khusus untuk Efek Running Text (Marquee) -->
<style>
    @keyframes marquee {
        0% { transform: translateX(100%); }
        100% { transform: translateX(-100%); }
    }
    .animate-marquee {
        display: inline-block;
        white-space: nowrap;
        animation: marquee 14s linear infinite;
    }
    .marquee-container:hover .animate-marquee {
        animation-play-state: paused;
    }
</style>

<aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-72 bg-emerald-800 text-white transition duration-300 transform -translate-x-full md:relative md:translate-x-0 flex flex-col shadow-xl">
    
    <!-- 1. BRAND / NAMA APLIKASI -->
    <div class="flex items-center justify-center h-14 bg-emerald-900 border-b border-emerald-700 px-4 flex-shrink-0">
        <h1 class="text-base font-bold truncate">🕌 MyMosque App</h1>
    </div>

    <!-- 2. WIDGET WAKTU REAL-TIME -->
    <div class="bg-emerald-900/60 border-b border-emerald-700 px-4 py-3 text-center flex-shrink-0 font-sans">
        <div id="realtime-clock" class="text-lg font-extrabold tracking-wider text-emerald-100">00:00:00</div>
        <div id="realtime-date" class="text-[11px] text-emerald-300 uppercase tracking-wide mt-0.5">Memuat waktu...</div>
    </div>

    <!-- 3. NAMA MASJID & ALAMAT -->
    <div class="px-3 py-2.5 bg-emerald-950/40 border-b border-emerald-700/50 flex-shrink-0 text-center overflow-hidden relative marquee-container">
        <p class="text-xs font-bold text-white uppercase truncate">
            <%= typeof appSettings !== 'undefined' && appSettings.mosque_name ? appSettings.mosque_name : 'Nama Masjid' %>
        </p>
        <div class="w-full overflow-hidden whitespace-nowrap mt-0.5">
            <div class="animate-marquee text-[11px] text-emerald-200">
                📍 <%= typeof appSettings !== 'undefined' && appSettings.mosque_address ? appSettings.mosque_address : 'Alamat Masjid' %>
            </div>
        </div>
    </div>
    
    <!-- 4. MENU-MENU NAVIGASI (DIAMANKAN DENGAN PERMISSION) -->
    <nav class="flex-1 px-4 py-4 space-y-2 overflow-y-auto font-sans">
        
        <% if (currentUser && (currentUser.role === 'Super Admin' || currentUser.permissions.includes('dashboard'))) { %>
            <a href="/admin/dashboard" class="flex items-center gap-3 px-4 py-3 text-emerald-100 hover:bg-emerald-700 hover:text-white rounded-lg transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                Beranda
            </a>
        <% } %>

        <!-- Menu Bertingkat Zakat -->
        <% if (currentUser && (currentUser.role === 'Super Admin' || currentUser.permissions.includes('zakat'))) { %>
            <div>
                <button onclick="toggleZakatMenu()" class="w-full flex items-center justify-between gap-3 px-4 py-3 text-emerald-100 hover:bg-emerald-700 hover:text-white rounded-lg transition-colors focus:outline-none">
                    <div class="flex items-center gap-3">
                        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Modul Zakat</span>
                    </div>
                    <svg id="zakat-arrow" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
                
                <!-- Sub-menu -->
                <div id="zakat-submenu" class="hidden mt-1 space-y-1 pl-11 pr-4">
                    <a href="/admin/zakat" class="block px-4 py-2 text-sm text-emerald-200 hover:text-white hover:bg-emerald-700 rounded-md transition-colors">Rekapitulasi Zakat</a>
                    <a href="/admin/zakat/input" class="block px-4 py-2 text-sm text-emerald-200 hover:text-white hover:bg-emerald-700 rounded-md transition-colors">Input Data Zakat</a>
                    <a href="/admin/zakat/laporan" class="block px-4 py-2 text-sm text-emerald-200 hover:text-white hover:bg-emerald-700 rounded-md transition-colors">Laporan Zakat</a>
                </div>
            </div>
        <% } %>

        <% if (currentUser && (currentUser.role === 'Super Admin' || currentUser.permissions.includes('users'))) { %>
            <a href="/admin/users" class="flex items-center gap-3 px-4 py-3 text-emerald-100 hover:bg-emerald-700 hover:text-white rounded-lg transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>            
                Manajemen Pengguna
            </a>
        <% } %>

        <!-- Menu Pengaturan Aplikasi -->
        <% if (currentUser && (currentUser.role === 'Super Admin' || currentUser.permissions.includes('settings'))) { %>
            <a href="/admin/settings" class="flex items-center gap-3 px-4 py-3 text-emerald-100 hover:bg-emerald-700 hover:text-white rounded-lg transition-colors">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                Pengaturan Aplikasi
            </a>
        <% } %>
    </nav>

<!-- ========================================== -->
<!-- WIDGET USER PROFILE & AKSI DI BAWAH SIDEBAR -->
<!-- ========================================== -->
<% if (locals.currentUser) { %>
    <div class="mt-auto p-4 bg-gray-900 border-t border-gray-800">
        <!-- Info User -->
        <div class="flex items-center space-x-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow flex-shrink-0">
                <%= currentUser.nama_lengkap ? currentUser.nama_lengkap.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="overflow-hidden">
                <p class="text-sm font-semibold text-white truncate"><%= currentUser.nama_lengkap || currentUser.username %></p>
                <span class="inline-block px-2 py-0.5 text-[10px] font-medium bg-emerald-900/60 text-emerald-300 rounded border border-emerald-700/50 truncate">
                    <%= currentUser.role %>
                </span>
            </div>
        </div>

        <!-- Tombol Aksi (Edit Profile & Logout) -->
        <div class="grid grid-cols-2 gap-2 pt-1 border-t border-gray-800">
            <a href="/admin/users/profile" class="flex items-center justify-center px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 hover:text-white rounded-lg text-xs font-medium transition-colors">
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Profil
            </a>
            <a href="/logout" onclick="openLogoutModal(event)" class="flex items-center justify-center px-3 py-1.5 bg-rose-900/40 hover:bg-rose-900 text-rose-300 hover:text-white rounded-lg text-xs font-medium transition-colors border border-rose-800/50">
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                Logout
            </a>
        </div>
    </div>
<% } %>

    <!-- 5. COPYRIGHT FOOTER -->
    <div class="px-4 py-3 bg-emerald-900/50 border-t border-emerald-700/60 text-center flex-shrink-0">
        <p class="text-[11px] text-emerald-200 font-medium">&copy; 2026 MyMosque App</p>
        <p class="text-[10px] text-emerald-400 mt-0.5">All Rights Reserved</p>
    </div>
</aside>

<!-- Modal Konfirmasi Logout Kustom -->
<div id="logoutModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="modalContainer">
        <div class="text-center">
            <!-- Ikon Peringatan -->
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Konfirmasi Keluar</h3>
            <p class="text-sm text-gray-500 mb-6">Apakah Anda yakin ingin keluar dari sesi sistem MyMosque?</p>
                
            <!-- Tombol Aksi Modal -->
            <div class="flex space-x-3">
                <button type="button" onclick="closeLogoutModal()" class="flex-1 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition-colors">
                    Batal
                </button>
                <a href="/logout" class="flex-1 px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors text-center flex items-center justify-center">
                    Ya, Keluar
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function openLogoutModal(event) {
        event.preventDefault(); // Mencegah link langsung berpindah halaman
        const modal = document.getElementById('logoutModal');
        const container = document.getElementById('modalContainer');
        
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeLogoutModal() {
        const modal = document.getElementById('logoutModal');
        const container = document.getElementById('modalContainer');
        
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }
    
    function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('-translate-x-full');
        document.getElementById('sidebar-overlay').classList.toggle('hidden');
    }
    
    function toggleZakatMenu() {
        document.getElementById('zakat-submenu').classList.toggle('hidden');
        document.getElementById('zakat-arrow').classList.toggle('rotate-180');
    }

    function updateClock() {
        const now = new Date();
        const userTimeZone = '<%= typeof appSettings !== "undefined" && appSettings.timezone ? appSettings.timezone : "Asia/Jakarta" %>';

        const timeOptions = {
            timeZone: userTimeZone, 
            hour: '2-digit', 
            minute: '2-digit', 
            second: '2-digit',
            hour12: false
        };

        const dateOptions = {
            timeZone: userTimeZone,
            weekday: 'long', 
            day: 'numeric', 
            month: 'long', 
            year: 'numeric'
        };

        const timeString = new Intl.DateTimeFormat('id-ID', timeOptions).format(now);
        const dateString = new Intl.DateTimeFormat('id-ID', dateOptions).format(now);

        document.getElementById('realtime-clock').innerText = timeString.replace(/\./g, ':');
        document.getElementById('realtime-date').innerText = dateString;
    }

    updateClock();
    setInterval(updateClock, 1000);
</script>