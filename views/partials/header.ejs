
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans text-gray-800">
    <div class="flex h-screen overflow-hidden">
        <%- include('sidebar') %>

        <div class="flex flex-col flex-1 w-full overflow-hidden">
            <!-- Mobile Header -->
            <header class="flex items-center justify-between px-4 py-3 bg-white shadow-sm md:hidden z-10">
                <h1 class="text-lg font-bold text-emerald-800">
                    🕌 <%= typeof appSettings !== 'undefined' && appSettings.app_name %>
                </h1>
                <button onclick="toggleSidebar()" class="text-gray-500 hover:text-emerald-700 focus:outline-none p-1">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                </button>
            </header>
            
            <main class="flex-1 overflow-y-auto p-4 lg:p-8">
