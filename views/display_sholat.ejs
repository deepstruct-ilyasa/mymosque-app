<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Display Sholat - <%= appSettings.mosque_name || 'MyMosque' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; }
        ::-webkit-scrollbar { display: none; }
        
        .bg-islamic {
            background-color: #065f46; 
            background-image: radial-gradient(#047857 2px, transparent 2px);
            background-size: 30px 30px;
        }

        @keyframes blink-bg {
            0%, 100% { background-color: #064e3b; }
            50% { background-color: #059669; }
        }
        .animate-blink-bg { animation: blink-bg 3s ease-in-out infinite; }

        .prayer-card {
                background: linear-gradient(145deg, rgba(15, 23, 42, 0.95) 0%, rgba(4, 47, 46, 0.9) 100%);
                border: 2px solid rgba(252, 211, 77, 0.35);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
                transition: all 0.3s ease;
            }
            .prayer-card p {
                color: #cbd5e1 !important;
            }
            .prayer-card h3, .prayer-card span, .prayer-card div.text-2xl {
                color: #ffffff !important;
            }
            
            .prayer-card-highlight {
                background: linear-gradient(145deg, #f59e0b 0%, #b45309 100%) !important;
                border: 2px solid #fde68a !important;
                box-shadow: 0 15px 35px rgba(245, 158, 11, 0.6) !important;
                transform: translateY(-4px);
            }
            .prayer-card-highlight p, 
            .prayer-card-highlight h3, 
            .prayer-card-highlight span {
                color: #ffffff !important;
            }

        .islamic-lux-frame {
            border: 8px double #fcd34d;
            box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.6), 0 0 40px rgba(245, 158, 11, 0.3);
            position: relative;
            background-color: #022c22;
            background-image: 
                radial-gradient(rgba(252, 211, 77, 0.25) 2px, transparent 2px),
                radial-gradient(rgba(252, 211, 77, 0.15) 2px, transparent 2px);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
        }

        .corner-ornament {
            position: absolute;
            width: 110px;
            height: 110px;
            border-color: #fcd34d;
            border-style: double;
            pointer-events: none;
            z-index: 20;
            background: radial-gradient(circle, rgba(252,211,77,0.15) 0%, transparent 70%);
        }
        .corner-tl { top: 15px; left: 15px; border-width: 12px 0 0 12px; border-top-left-radius: 20px; }
        .corner-tr { top: 15px; right: 15px; border-width: 12px 12px 0 0; border-top-right-radius: 20px; }
        .corner-bl { bottom: 15px; left: 15px; border-width: 0 0 12px 12px; border-bottom-left-radius: 20px; }
        .corner-br { bottom: 15px; right: 15px; border-width: 0 12px 12px 0; border-bottom-right-radius: 20px; }

        @keyframes pulse-glow {
            0%, 100% { box-shadow: 0 0 25px rgba(252, 211, 77, 0.5); }
            50% { box-shadow: 0 0 50px rgba(252, 211, 77, 0.9); }
        }
        .glow-box { animation: pulse-glow 2.5s infinite; }
        
        .divider-line {
            width: 300px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #fcd34d, transparent);
            margin: 15px auto;
        }
    </style>
</head>
<body class="h-screen w-screen overflow-hidden text-slate-800 relative bg-slate-100 flex flex-col">

    <!-- AUDIO PLAYER TERSEMBUNYI UNTUK TARKHIM -->
    <audio id="tarkhimPlayer" preload="auto"></audio>

    <!-- VIEW 1: NORMAL -->
    <div id="view-normal" class="flex flex-col h-full w-full transition-opacity duration-1000 bg-slate-950 islamic-lux-frame relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#fcd34d 1.5px, transparent 1.5px); background-size: 40px 40px;"></div>

        <header class="bg-slate-900/80 backdrop-blur-md text-white shadow-xl flex-shrink-0 z-10 border-b-4 border-amber-400/80">
            <div class="px-8 py-3 flex justify-between items-center">
                <div class="flex items-center gap-5">
                    <div class="w-24 h-24 flex items-center justify-center overflow-hidden flex-shrink-0 bg-slate-950 rounded-2xl border-2 border-amber-400/40 shadow-inner">
                        <% if (typeof appSettings !== 'undefined' && appSettings.logo) { %>
                            <img src="/uploads/<%= appSettings.logo %>" alt="Logo Masjid" class="w-full h-full object-contain p-1">
                        <% } else { %>
                            <svg class="w-9 h-9 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9 7h6l-3-5zm-5 7a2 2 0 00-2 2v9a2 2 0 002 2h10a2 2 0 002-2v-9a2 2 0 00-2-2H7zm5 2a3 3 0 110 6 3 3 0 010-6zm-4.5 7a1.5 1.5 0 110-3 1.5 1.5 0 010 3zm9 0a1.5 1.5 0 110-3 1.5 1.5 0 010 3z"/></svg>
                        <% } %>
                    </div>
                    <div>
                        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight uppercase text-amber-300 drop-shadow-md" id="labelNamaMasjid">
                            <%= appSettings.mosque_name || 'undefined' %>
                        </h1>
                        <p class="text-emerald-300 font-semibold tracking-wide text-sm md:text-base uppercase mt-1" id="labelKotaHeader">
                            Memuat Kota...
                        </p>
                    </div>
                </div>
                <div class="text-right bg-slate-900/90 px-6 py-3 rounded-2xl border border-amber-400/30 shadow-lg backdrop-blur-md">
                    <h2 class="text-2xl md:text-4xl font-bold text-white tracking-wide" id="tanggalMasehi">Memuat...</h2>
                    <p class="text-amber-300 font-bold text-lg md:text-3xl mt-1 tracking-wider" id="tanggalHijriyah">Memuat...</p>
                </div>
            </div>
        </header>

        <main class="flex-grow flex flex-col items-center justify-center relative py-1 z-10">
            <div class="text-center z-10">
                <h2 class="text-[25rem] md:text-[28rem] font-black leading-none text-white tracking-tighter flex items-baseline justify-center drop-shadow-[0_10px_30px_rgba(252,211,77,0.2)] font-mono" id="jamMenitDigital">
                    00:00
                </h2>
            </div>
        </main>

        <div class="px-6 pb-6 w-full max-w-[99vw] mx-auto z-10">
            <div class="grid grid-cols-7 gap-3 md:gap-4" id="jadwalContainer">
                <div class="prayer-card py-10 px-4 rounded-3xl text-center animate-pulse col-span-7">
                    <p class="text-emerald-300 font-bold uppercase tracking-widest text-lg">Menyinkronkan Waktu Sholat...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- VIEW 2: MENJELANG ADZAN (PREP ADZAN) -->
    <div id="view-prep-adzan" class="hidden absolute inset-0 z-40 bg-amber-950 islamic-lux-frame flex flex-col items-center justify-center text-center px-4 text-white">
        <div class="corner-ornament corner-tl"></div>
        <div class="corner-ornament corner-tr"></div>
        <div class="corner-ornament corner-bl"></div>
        <div class="corner-ornament corner-br"></div>

        <div class="z-10 flex flex-col items-center max-w-5xl">
            <h2 class="text-3xl md:text-5xl font-black tracking-[0.25em] uppercase mb-2 text-amber-200 drop-shadow-lg">MENJELANG MASUK WAKTU</h2>
            <div class="divider-line"></div>
            <h1 class="text-[7rem] md:text-[10rem] font-black tracking-tight text-white uppercase drop-shadow-2xl mb-6 leading-none text-yellow-300" id="labelPrepAdzan">DZUHUR</h1>
            <div class="divider-line"></div>
            <div class="bg-amber-900/95 px-20 py-8 rounded-3xl border-4 border-amber-400 glow-box mb-6 shadow-2xl backdrop-blur-md">
                <h1 class="text-[8rem] md:text-[12rem] font-mono font-black tracking-tight text-amber-200 leading-none drop-shadow-md" id="countdownPrepAdzan">00:00</h1>
            </div>
            <p class="text-2xl md:text-4xl font-extrabold text-amber-100 animate-pulse tracking-wider bg-amber-800/60 px-8 py-3 rounded-2xl border border-amber-500/40">Bersiaplah Menuju Sholat Berjamaah</p>
        </div>
    </div>

    <!-- VIEW 3: ADZAN -->
    <div id="view-adzan" class="hidden absolute inset-0 z-40 animate-blink-bg islamic-lux-frame flex flex-col items-center justify-center text-center px-4 text-white">
        <div class="corner-ornament corner-tl"></div>
        <div class="corner-ornament corner-tr"></div>
        <div class="corner-ornament corner-bl"></div>
        <div class="corner-ornament corner-br"></div>

        <div class="z-10 flex flex-col items-center max-w-5xl">
            <h2 class="text-4xl md:text-6xl font-black tracking-[0.25em] uppercase mb-4 text-emerald-100 drop-shadow-lg">TELAH MASUK WAKTU</h2>
            <div class="divider-line"></div>
            <h1 class="text-[8rem] md:text-[12rem] font-black tracking-tight text-white drop-shadow-2xl uppercase mb-6 leading-none text-amber-300" id="labelAdzan">SHOLAT</h1>
            <div class="divider-line"></div>
            <p class="text-3xl md:text-4xl font-black text-amber-200 tracking-wider drop-shadow-md bg-emerald-950/80 px-10 py-4 rounded-2xl border-2 border-emerald-400/50 shadow-2xl">Harap Tenang & Dengarkan Adzan</p>
        </div>
    </div>

    <!-- VIEW 4: IQOMAH -->
    <div id="view-iqomah" class="hidden absolute inset-0 z-40 bg-slate-950 islamic-lux-frame flex flex-col items-center justify-center text-center px-4 text-white">
        <div class="corner-ornament corner-tl"></div>
        <div class="corner-ornament corner-tr"></div>
        <div class="corner-ornament corner-bl"></div>
        <div class="corner-ornament corner-br"></div>

        <div class="z-10 flex flex-col items-center max-w-5xl">
            <h2 class="text-3xl md:text-5xl font-black tracking-[0.25em] uppercase mb-2 text-slate-300 drop-shadow-lg">MENUJU IQOMAH</h2>
            <div class="divider-line"></div>
            <h1 class="text-[6rem] md:text-[9rem] font-black tracking-tight text-emerald-400 uppercase drop-shadow-lg mb-6 leading-none" id="labelIqomah">SHOLAT</h1>
            <div class="divider-line"></div>
            <div class="bg-slate-900/95 px-20 py-8 rounded-3xl border-4 border-slate-700 glow-box mb-6 shadow-2xl">
                <h1 class="text-[8rem] md:text-[12rem] font-mono font-black tracking-tight text-white leading-none drop-shadow-md" id="countdownIqomah">00:00</h1>
            </div>
            <p class="text-2xl md:text-4xl font-extrabold text-amber-400 animate-pulse tracking-wider bg-slate-900/80 px-8 py-3 rounded-2xl border border-slate-800">Bersiaplah, Luruskan dan Rapatkan Shaf</p>
        </div>
    </div>

    <!-- VIEW 5: SHOLAT / KHUTBAH -->
    <div id="view-sholat" class="hidden absolute inset-0 z-50 bg-black islamic-lux-frame flex flex-col items-center justify-center text-center px-6 text-white">
        <div class="corner-ornament corner-tl"></div>
        <div class="corner-ornament corner-tr"></div>
        <div class="corner-ornament corner-bl"></div>
        <div class="corner-ornament corner-br"></div>

        <div class="z-10 flex flex-col items-center max-w-6xl">
            <div class="divider-line"></div>
            <h1 class="text-4xl md:text-7xl font-black tracking-widest uppercase text-slate-100 drop-shadow-xl mb-6 leading-tight" id="labelPeringatanSholat">
                MOHON NONAKTIFKAN ALAT KOMUNIKASI
            </h1>
            <div class="divider-line"></div>
            <p class="text-2xl md:text-4xl font-extrabold text-amber-400 tracking-wider bg-slate-900/90 px-10 py-4 rounded-2xl border border-slate-800 shadow-xl">Sholat Sedang Berlangsung</p>
        </div>
    </div>

    <!-- RUNNING TEXT -->
    <div id="footer-running-text" class="bg-emerald-900 flex items-center h-20 w-full z-20 shadow-2xl relative overflow-hidden border-t-4 border-emerald-700">
        <div class="bg-amber-500 h-full px-6 md:px-10 flex items-center justify-center flex-shrink-0 z-30 shadow-lg border-r-4 border-amber-600">
            <span class="text-emerald-950 font-black tracking-widest uppercase flex items-center gap-2 text-lg md:text-xl">
                PENGUMUMAN
            </span>
        </div>
        <div class="h-full flex items-center text-2xl md:text-3xl font-semibold text-white px-6 w-full overflow-hidden">
            <div id="staticRunningText" class="transition-opacity duration-500 opacity-100">
                Memuat pengumuman...
            </div>
        </div>
    </div>

    <!-- SCRIPT LOGIKA UTAMA -->
    <script>
        let configDisplay = {
            city: "Yogyakarta",
            timezone: "Asia/Jakarta",
            running_text: "Selamat datang di Masjid",
            durasi_adzan: 3,
            durasi_khutbah: 45,
            prep_tarkhim_menit: 10,
            tarkhim_playlist: [],
            iqomah: { Subuh: 1, Dzuhur: 1, Ashar: 1, Maghrib: 1, Isya: 1 },
            prep_adzan: { Subuh: 10, Dzuhur: 10, Ashar: 10, Maghrib: 10, Isya: 10 },
            sholat_duration: { Subuh: 10, Dzuhur: 10, Ashar: 10, Maghrib: 10, Isya: 10 }
        };

        let jadwalHariIni = {};
        let lastFetchedCity = "";
        let timeOffset = 0;
        let isTarkhimPlaying = false;
        let lastPlayedPrayerName = "";
        let runningTextArray = ["Selamat datang di Masjid"];
        let currentTextIndex = 0;
        let currentTarkhimFile = "";
        let isTarkhimStartedOnce = false;
        let activeSimulationMode = null;

        const DURASI = {
            ADZAN: 1 * 60,
            KHUTBAH: 20 * 60
        };

        const vNormal = document.getElementById('view-normal');
        const vPrepAdzan = document.getElementById('view-prep-adzan');
        const vAdzan = document.getElementById('view-adzan');
        const vIqomah = document.getElementById('view-iqomah');
        const vSholat = document.getElementById('view-sholat');
        const footer = document.getElementById('footer-running-text');

        function setActiveView(viewName) {
            vNormal.classList.add('hidden');
            vPrepAdzan.classList.add('hidden');
            vAdzan.classList.add('hidden');
            vIqomah.classList.add('hidden');
            vSholat.classList.add('hidden');
            footer.classList.remove('hidden');

            if (viewName === 'NORMAL') {
                vNormal.classList.remove('hidden');
            } else if (viewName === 'PREP_ADZAN') {
                vPrepAdzan.classList.remove('hidden');
            } else if (viewName === 'ADZAN') {
                vAdzan.classList.remove('hidden');
            } else if (viewName === 'IQOMAH') {
                vIqomah.classList.remove('hidden');
            } else if (viewName === 'SHOLAT' || viewName === 'KHUTBAH') {
                vSholat.classList.remove('hidden');
                footer.classList.add('hidden');
            }
        }

        function startTarkhim(prayerName = "") {
            const player = document.getElementById('tarkhimPlayer');
            if (!player) return;

            if (isTarkhimStartedOnce && lastPlayedPrayerName === prayerName) {
                return; 
            }

            if (configDisplay.tarkhim_playlist && configDisplay.tarkhim_playlist.length > 0) {
                currentTarkhimFile = configDisplay.tarkhim_playlist[Math.floor(Math.random() * configDisplay.tarkhim_playlist.length)];
                player.src = currentTarkhimFile;
                player.loop = true; 
                lastPlayedPrayerName = prayerName; 
                
                player.play().then(() => {
                    isTarkhimPlaying = true;
                    isTarkhimStartedOnce = true;
                    console.log(`Tarkhim (${prayerName}) terkunci & bernyanyi mulus.`);
                }).catch(e => {
                    console.warn("Autoplay dicegah browser:", e);
                });
            } else {
                console.warn("Playlist tarkhim kosong!");
            }
        }

        function stopTarkhim() {
            const player = document.getElementById('tarkhimPlayer');
            if (player) {
                player.pause();
                player.currentTime = 0;
                player.src = "";
                isTarkhimPlaying = false; 
                isTarkhimStartedOnce = false; 
                lastPlayedPrayerName = ""; 
                currentTarkhimFile = ""; 
                console.log("Tarkhim dimatikan total secara bersih.");
            }
        }

        function getCorrectedTime() {
            const serverRawTime = new Date(Date.now() + timeOffset);
            let rawTz = (configDisplay.timezone || 'WIB').trim().toUpperCase();
            let ianaTimeZone = 'Asia/Jakarta';

            if (rawTz.includes('WITA') || rawTz.includes('MAKASSAR') || rawTz === 'ASIA/MAKASSAR') {
                ianaTimeZone = 'Asia/Makassar';
            } else if (rawTz.includes('WIT') || rawTz.includes('JAYAPURA') || rawTz === 'ASIA/JAYAPURA') {
                ianaTimeZone = 'Asia/Jayapura';
            } else if (rawTz.includes('WIB') || rawTz.includes('JAKARTA') || rawTz === 'ASIA/JAKARTA') {
                ianaTimeZone = 'Asia/Jakarta';
            } else if (rawTz.includes('/')) {
                ianaTimeZone = configDisplay.timezone;
            }

            try {
                const formatter = new Intl.DateTimeFormat('en-US', {
                    timeZone: ianaTimeZone,
                    year: 'numeric', month: 'numeric', day: 'numeric',
                    hour: 'numeric', minute: 'numeric', second: 'numeric',
                    hour12: false
                });

                const parts = formatter.formatToParts(serverRawTime);
                let tzYear, tzMonth, tzDay, tzHour, tzMinute, tzSecond;

                parts.forEach(p => {
                    if (p.type === 'year') tzYear = parseInt(p.value);
                    if (p.type === 'month') tzMonth = parseInt(p.value) - 1;
                    if (p.type === 'day') tzDay = parseInt(p.value);
                    if (p.type === 'hour') tzHour = parseInt(p.value);
                    if (p.type === 'minute') tzMinute = parseInt(p.value);
                    if (p.type === 'second') tzSecond = parseInt(p.value);
                });

                if (tzHour === 24) tzHour = 0;
                return new Date(tzYear, tzMonth, tzDay, tzHour, tzMinute, tzSecond);
            } catch (e) {
                return serverRawTime;
            }
        }

        function evaluatePrayerState(correctedTime) {
            if (activeSimulationMode) return;

            const timeNowSec = (correctedTime.getHours() * 3600) + (correctedTime.getMinutes() * 60) + correctedTime.getSeconds();
            const isJumat = (correctedTime.getDay() === 5);

            let currentMode = 'NORMAL';
            let activePrayerName = '';
            let countdownValue = 0;
            let prepCountdownValue = 0;
            let shouldPlayTarkhim = false; 

            let durasiAdzanSec = (configDisplay.durasi_adzan || 3) * 60;
            let durasiKhutbahSec = (configDisplay.durasi_khutbah || 45) * 60;
            
            let tarkhimMnitConfig = parseInt(configDisplay.prep_tarkhim_menit);
            let tarkhimSecsBefore = (isNaN(tarkhimMnitConfig) ? 10 : tarkhimMnitConfig) * 60;

            for (const [nama, waktu] of Object.entries(jadwalHariIni)) {
                if (nama === 'Imsak' || nama === 'Terbit') continue;

                const [pHour, pMin] = waktu.split(':').map(Number);
                const prayerTimeSec = (pHour * 3600) + (pMin * 60);
                const diff = timeNowSec - prayerTimeSec; 

                let keyName = nama === "JUM'AT" ? "Dzuhur" : nama;
                let prepSecs = (configDisplay.prep_adzan && configDisplay.prep_adzan[keyName]) ? configDisplay.prep_adzan[keyName] : 60;
                let durasiIqomahMnit = (configDisplay.iqomah && configDisplay.iqomah[keyName]) ? configDisplay.iqomah[keyName] : 10;
                let durasiIqomahSec = durasiIqomahMnit * 60;
                let sholatMnit = (configDisplay.sholat_duration && configDisplay.sholat_duration[keyName]) ? configDisplay.sholat_duration[keyName] : 15;
                let sholatSecs = sholatMnit * 60;

                // --- 1. ATURAN AUDIO TARKHIM ---
                if (!isJumat && diff < 0 && Math.abs(diff) <= tarkhimSecsBefore) {
                    shouldPlayTarkhim = true;
                    activePrayerName = nama;
                }

                // --- 2. ATURAN TAMPILAN VIEW (PREP ADZAN) ---
                if (diff < 0 && diff >= -prepSecs) {
                    currentMode = 'PREP_ADZAN'; 
                    activePrayerName = nama;
                    prepCountdownValue = Math.abs(diff);
                }

                // --- 3. ATURAN SETELAH MASUK WAKTU SHOLAT ---
                if (diff >= 0) {
                    if (isJumat && nama === "JUM'AT") {
                        if (diff < durasiAdzanSec) {
                            currentMode = 'ADZAN';
                            activePrayerName = nama;
                        } else if (diff < (durasiAdzanSec + durasiKhutbahSec)) {
                            currentMode = 'KHUTBAH';
                        }
                    } else {
                        if (diff < durasiAdzanSec) {
                            currentMode = 'ADZAN';
                            activePrayerName = nama;
                        } else if (diff < (durasiAdzanSec + durasiIqomahSec)) {
                            currentMode = 'IQOMAH';
                            activePrayerName = nama;
                            countdownValue = (durasiAdzanSec + durasiIqomahSec) - diff;
                        } else if (diff < (durasiAdzanSec + durasiIqomahSec + sholatSecs)) {
                            currentMode = 'SHOLAT';
                        }
                    }
                }
            }

            let visualViewMode = currentMode;
            if (shouldPlayTarkhim && currentMode !== 'PREP_ADZAN' && currentMode !== 'ADZAN' && currentMode !== 'IQOMAH' && currentMode !== 'SHOLAT' && currentMode !== 'KHUTBAH') {
                visualViewMode = 'NORMAL';
            }

            setActiveView(visualViewMode);

            // --- KONTROL AUDIO TARKHIM ---
            if (shouldPlayTarkhim && !isTarkhimStartedOnce) {
                startTarkhim(activePrayerName);
            } 
            
            if (currentMode === 'ADZAN') {
                stopTarkhim();
            }

            // --- RENDER TAMPILAN HITUNG MUNDUR & MODE LAINNYA ---
            if (visualViewMode === 'PREP_ADZAN') {
                const elLabel = document.getElementById('labelPrepAdzan');
                const elCount = document.getElementById('countdownPrepAdzan');
                if (elLabel) elLabel.innerText = activePrayerName;
                if (elCount) {
                    const m = String(Math.floor(prepCountdownValue / 60)).padStart(2, '0');
                    const s = String(prepCountdownValue % 60).padStart(2, '0');
                    elCount.innerText = `${m}:${s}`;
                }
            } else if (currentMode === 'ADZAN') {
                const elAdzan = document.getElementById('labelAdzan');
                if (elAdzan) elAdzan.innerText = activePrayerName;
            } else if (currentMode === 'IQOMAH') {
                const elIqomahLabel = document.getElementById('labelIqomah');
                const elIqomahCount = document.getElementById('countdownIqomah');
                if (elIqomahLabel) elIqomahLabel.innerText = activePrayerName;
                if (elIqomahCount) {
                    const m = String(Math.floor(countdownValue / 60)).padStart(2, '0');
                    const s = String(countdownValue % 60).padStart(2, '0');
                    const newText = `${m}:${s}`;

                    if (countdownValue <= 10 && countdownValue > 0 && elIqomahCount.innerText !== newText) {
                        playBeep(countdownValue === 1); 
                    }

                    elIqomahCount.innerText = newText;
                }
            }
        }

        async function fetchJadwalSholat(cityName, correctedTime = new Date()) {
            try {
                const dd = String(correctedTime.getDate()).padStart(2, '0');
                const mm = String(correctedTime.getMonth() + 1).padStart(2, '0');
                const yyyy = correctedTime.getFullYear();
                const dateStr = `${dd}-${mm}-${yyyy}`;
                const isJumat = (correctedTime.getDay() === 5);

                const response = await fetch(`https://api.aladhan.com/v1/timingsByCity/${dateStr}?city=${encodeURIComponent(cityName)}&country=Indonesia&method=11`);
                const data = await response.json();

                if (data && data.code === 200) {
                    const timings = data.data.timings;
                    const hijri = data.data.date.hijri;
                    document.getElementById('tanggalHijriyah').innerText = `${hijri.day} ${hijri.month.en} ${hijri.year} H`;
                    
                    jadwalHariIni = {
                        'Imsak': timings.Imsak,
                        'Subuh': timings.Fajr,
                        'Terbit': timings.Sunrise,
                        [isJumat ? "JUM'AT" : "Dzuhur"]: timings.Dhuhr,
                        'Ashar': timings.Asr,
                        'Maghrib': timings.Maghrib,
                        'Isya': timings.Isha
                    };

                    localStorage.setItem('mosque_jadwal_' + dateStr, JSON.stringify({
                        jadwal: jadwalHariIni,
                        hijriyah: document.getElementById('tanggalHijriyah').innerText
                    }));

                    renderJadwalCards();
                }
            } catch (error) {
                loadJadwalFromCacheOrFallback();
            }
        }

        function loadJadwalFromCacheOrFallback() {
            const correctedTime = new Date(Date.now() + timeOffset);
            const dd = String(correctedTime.getDate()).padStart(2, '0');
            const mm = String(correctedTime.getMonth() + 1).padStart(2, '0');
            const yyyy = correctedTime.getFullYear();
            const dateStr = `${dd}-${mm}-${yyyy}`;

            const cachedJadwalData = localStorage.getItem('mosque_jadwal_' + dateStr);
            if (cachedJadwalData) {
                const parsed = JSON.parse(cachedJadwalData);
                jadwalHariIni = parsed.jadwal;
                document.getElementById('tanggalHijriyah').innerText = parsed.hijriyah + " (OFFLINE)";
                renderJadwalCards();
            }
        }

        function renderJadwalCards() {
            if (Object.keys(jadwalHariIni).length === 0) return;

            const now = getCorrectedTime();
            const timeNowSec = (now.getHours() * 3600) + (now.getMinutes() * 60) + now.getSeconds();

            let nextPrayerFound = '';
            const entries = Object.entries(jadwalHariIni);

            for (let i = 0; i < entries.length; i++) {
                const [nama, waktu] = entries[i];
                if (nama === 'Imsak' || nama === 'Terbit') continue;

                const [pHour, pMin] = waktu.split(':').map(Number);
                const prayerTimeSec = (pHour * 3600) + (pMin * 60);

                if (timeNowSec < prayerTimeSec) {
                    nextPrayerFound = nama;
                    break;
                }
            }
            if (!nextPrayerFound) nextPrayerFound = 'Subuh';

            let html = '';
            for (const [nama, waktu] of entries) {
                const isNext = (nama === nextPrayerFound);
                const cardStyle = isNext 
                    ? 'prayer-card-highlight text-white rounded-3xl py-10 md:py-12 px-2 text-center flex flex-col justify-center items-center shadow-2xl relative overflow-hidden' 
                    : 'prayer-card text-slate-800 rounded-3xl py-10 md:py-12 px-2 text-center flex flex-col justify-center items-center';
                
                const textSubColor = isNext ? 'text-amber-100 font-black' : 'text-emerald-700 font-extrabold';
                const textTimeColor = isNext ? 'text-white' : 'text-emerald-950';

                html += `
                    <div class="${cardStyle} transition-all duration-300">
                        ${isNext ? '<div class="absolute top-0 left-0 right-0 bg-yellow-400 text-slate-950 text-xl font-black py-3 uppercase tracking-widest shadow-md">AKAN DATANG</div>' : ''}
                        <p class="text-2xl md:text-3xl ${textSubColor} uppercase tracking-[0.2em] ${isNext ? 'mt-3' : ''} mb-3">${nama}</p>
                        <h3 class="text-5xl md:text-7xl font-black ${textTimeColor} tracking-tight drop-shadow-sm">${waktu}</h3>
                    </div>
                `;
            }
            document.getElementById('jadwalContainer').innerHTML = html;
        }

        async function syncDisplaySettings() {
            try {
                const res = await fetch('/api/display-settings');
                if (!res.ok) throw new Error("Gagal");
                const data = await res.json();
                
                configDisplay = { ...data, timezone: data.timezone || configDisplay.timezone };
                localStorage.setItem('mosque_config_cache', JSON.stringify(configDisplay));

                if (data.mosque_name) {
                    const elNama = document.getElementById('labelNamaMasjid');
                    if (elNama) elNama.innerText = data.mosque_name;
                }

                if (data.tarkhim_playlist && data.tarkhim_playlist.length > 0) {
                    cacheTarkhimAudio(data.tarkhim_playlist);
                }

                if (data.server_time) {
                    timeOffset = data.server_time - Date.now();
                    localStorage.setItem('mosque_time_offset', timeOffset);
                }

                document.getElementById('labelKotaHeader').innerText = `KOTA ${data.city} & SEKITARNYA`;

                let rawText = data.running_text || "Selamat datang di Masjid";
                runningTextArray = rawText.split('\n').map(p => p.trim()).filter(p => p.length > 0);
                if (runningTextArray.length === 0) runningTextArray = ["Selamat datang di Masjid"];

                const correctedNow = new Date(Date.now() + timeOffset);
                if (lastFetchedCity !== data.city) {
                    lastFetchedCity = data.city;
                    fetchJadwalSholat(data.city, correctedNow);
                } else {
                    renderJadwalCards();
                }
            } catch (e) {
                const cachedConfig = localStorage.getItem('mosque_config_cache');
                const cachedOffset = localStorage.getItem('mosque_time_offset');
                if (cachedConfig) configDisplay = JSON.parse(cachedConfig);
                if (cachedOffset) timeOffset = parseInt(cachedOffset);
                loadJadwalFromCacheOrFallback();
            }
        }

        function initStaticRunningText() {
            const el = document.getElementById('staticRunningText');
            if (!el) return;
            setInterval(() => {
                if (runningTextArray.length > 0) {
                    currentTextIndex = (currentTextIndex + 1) % runningTextArray.length;
                    el.style.opacity = 0;
                    setTimeout(() => {
                        el.innerHTML = `<span class="text-amber-400 mr-2">🕌</span> ${runningTextArray[currentTextIndex]}`;
                        el.style.opacity = 1;
                    }, 300);
                }
            }, 6000);
        }

        function tick() {
            const correctedTime = getCorrectedTime();
            const jam = String(correctedTime.getHours()).padStart(2, '0');
            const menit = String(correctedTime.getMinutes()).padStart(2, '0');
            
            document.getElementById('jamMenitDigital').innerHTML = `${jam}:${menit}`;
            
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('tanggalMasehi').innerText = correctedTime.toLocaleDateString('id-ID', options);

            if (Object.keys(jadwalHariIni).length > 0) {
                evaluatePrayerState(correctedTime);
                renderJadwalCards();
            }
        }

        async function cacheTarkhimAudio(playlist) {
            try {
                for (const url of playlist) {
                    if (!sessionStorage.getItem('cached_' + url)) {
                        const audio = new Audio();
                        audio.src = url;
                        audio.preload = 'auto';
                        sessionStorage.setItem('cached_' + url, 'true');
                    }
                }
            } catch (err) {}
        }

        function playBeep(isLongBeep = false) {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioCtx.createOscillator();
                const gainNode = audioCtx.createGain();

                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(isLongBeep ? 880 : 600, audioCtx.currentTime); 
                gainNode.gain.setValueAtTime(0.15, audioCtx.currentTime);
                
                const duration = isLongBeep ? 0.7 : 0.12;
                gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);

                oscillator.connect(gainNode);
                gainNode.connect(audioCtx.destination);

                oscillator.start();
                oscillator.stop(audioCtx.currentTime + duration);
            } catch (e) {
                console.warn("Audio context tidak didukung browser:", e);
            }
        }

        syncDisplaySettings();
        tick();
        initStaticRunningText();

        setInterval(tick, 10000); 

        setInterval(() => {
            const isPrepActive = !vPrepAdzan.classList.contains('hidden');
            const isIqomahActive = !vIqomah.classList.contains('hidden');
            
            if (isPrepActive || isIqomahActive) {
                const correctedTime = getCorrectedTime();
                evaluatePrayerState(correctedTime);
            }
        }, 1000);

        setInterval(syncDisplaySettings, 300000);
    </script>
</body>
</html>