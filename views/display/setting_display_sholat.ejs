<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto p-4 md:p-6 mt-4 font-sans space-y-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 relative">
        <h1 class="text-2xl font-black text-emerald-900 mb-6">🖥️ Pengaturan Modul Display & Tarkhim Berbasis Waktu Sholat</h1>

        <form action="/admin/display/settings/update" method="POST" enctype="multipart/form-data" class="space-y-8">
            
            <!-- 1. PENGATURAN GLOBAL -->
            <div class="bg-emerald-50/50 p-5 rounded-2xl border border-emerald-100 space-y-4">
                <h3 class="text-base font-black text-emerald-900 uppercase tracking-wider">🌍 Pengaturan Umum Display</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Kota / Wilayah (Jadwal Sholat Kemenag)</label>
                        <input type="text" name="sholat_city" value="<%= generalSettings.sholat_city || '' %>" required class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Durasi Adzan (Menit)</label>
                            <input type="number" name="durasi_adzan_menit" value="<%= generalSettings.durasi_adzan_menit || 3 %>" required class="w-full border border-gray-300 rounded-lg p-3 text-sm text-center bg-white">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Durasi Khutbah (Menit)</label>
                            <input type="number" name="durasi_khutbah_menit" value="<%= generalSettings.durasi_khutbah_menit || 45 %>" required class="w-full border border-gray-300 rounded-lg p-3 text-sm text-center bg-white">
                        </div>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Teks Pengumuman Berjalan (Running Text)</label>
                    <textarea name="sholat_running_text" rows="3" class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white"><%= generalSettings.sholat_running_text || '' %></textarea>
                </div>
            </div>

            <!-- 2. PENGATURAN SPESIFIK PER WAKTU SHOLAT -->
            <div class="space-y-6">
                <h3 class="text-lg font-black text-gray-800 border-t pt-4">⏰ Konfigurasi Detail Per Waktu Sholat & Tarkhim</h3>
                
                <% if (sholatList && sholatList.length > 0) { %>
                    <% sholatList.forEach(sholat => { %>
                        <div class="bg-gray-50 rounded-2xl border border-gray-200 p-5 space-y-4 shadow-sm">
                            
                            <!-- Header Nama Sholat & Toggle ON/OFF Tarkhim -->
                            <div class="flex flex-wrap justify-between items-center border-b pb-3 gap-2">
                                <h4 class="text-lg font-black text-emerald-900 flex items-center gap-2">
                                    <span class="w-8 h-8 rounded-xl bg-emerald-600 text-white flex items-center justify-center text-sm"><%= sholat.id_sholat %></span>
                                    <%= sholat.nama_sholat %>
                                </h4>

                                <!-- TOGGLE ON/OFF TARKHIM -->
                                <div class="flex items-center gap-3 bg-white px-4 py-2 rounded-xl border border-gray-200">
                                    <span class="text-xs font-bold text-gray-600 uppercase">Audio Tarkhim:</span>
                                    <label class="relative inline-flex items-center cursor-pointer">
                                        <input type="checkbox" name="tarkhim_active_<%= sholat.id_sholat %>" value="1" <%= sholat.tarkhim_active == 1 ? 'checked' : '' %> class="sr-only peer">
                                        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                                        <span class="ml-2 text-xs font-bold text-gray-700 peer-checked:text-emerald-700">Active</span>
                                    </label>
                                </div>
                            </div>

                            <!-- Grid Parameter Waktu (Adzan, Iqomah, Durasi Sholat, Tarkhim Detik) -->
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                                <div>
                                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Hitung Mundur Adzan (Detik)</label>
                                    <input type="number" name="prep_adzan_detik_<%= sholat.id_sholat %>" value="<%= sholat.prep_adzan_detik %>" class="w-full border rounded-lg p-2.5 text-sm text-center bg-white" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Durasi Iqomah (Menit)</label>
                                    <input type="number" name="iqomah_menit_<%= sholat.id_sholat %>" value="<%= sholat.iqomah_menit %>" class="w-full border rounded-lg p-2.5 text-sm text-center bg-white" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Durasi Sholat (Menit)</label>
                                    <input type="number" name="durasi_sholat_menit_<%= sholat.id_sholat %>" value="<%= sholat.durasi_sholat_menit %>" class="w-full border rounded-lg p-2.5 text-sm text-center bg-white" required>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-gray-600 mb-1">Mulai Tarkhim (Detik)</label>
                                    <input type="number" id="prep_tarkhim_detik_<%= sholat.id_sholat %>" name="prep_tarkhim_detik_<%= sholat.id_sholat %>" value="<%= sholat.prep_tarkhim_detik %>" class="w-full border rounded-lg p-2.5 text-sm text-center bg-emerald-50 font-bold text-emerald-800" required>
                                </div>
                            </div>

                            <!-- Manajemen Audio Tarkhim Spesifik Per Sholat -->
                            <div class="bg-white p-4 rounded-xl border border-gray-200 space-y-3">
                                <label class="block text-xs font-bold text-gray-700">🎵 Upload Audio Tarkhim untuk <%= sholat.nama_sholat %> (Bisa lebih dari 1):</label>
                                <input type="file" name="tarkhim_files_<%= sholat.id_sholat %>" accept="audio/mp3,audio/wav,audio/mpeg" multiple class="block w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                                
                                <!-- List Audio yang sudah di-upload untuk sholat ini -->
                                <div class="mt-2 space-y-1" id="audioListContainer_<%= sholat.id_sholat %>">
                                    <% 
                                        const filteredAudio = tarkhimList.filter(a => a.id_sholat === sholat.id_sholat);
                                    %>
                                    <% if (filteredAudio.length > 0) { %>
                                        <ul class="divide-y divide-gray-100 border rounded-lg overflow-hidden text-xs">
                                            <% filteredAudio.forEach(audio => { %>
                                                <li class="px-3 py-2 flex justify-between items-center bg-gray-50" id="audio-row-<%= audio.id %>">
                                                    <span class="font-medium text-gray-700 truncate">▶️ <%= audio.original_name %></span>
                                                    <button type="button" onclick="openDeleteModal('<%= audio.id %>', '<%= audio.original_name %>', '<%= sholat.id_sholat %>')" class="text-red-500 hover:text-red-700 font-bold bg-red-50 px-2.5 py-1 rounded">Hapus</button>
                                                </li>
                                            <% }) %>
                                        </ul>
                                    <% } else { %>
                                        <p class="text-[11px] text-gray-400 italic" id="emptyAudioText_<%= sholat.id_sholat %>">Belum ada file audio tarkhim untuk waktu ini.</p>
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    <% }) %>
                <% } %>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl transition shadow-lg text-base">
                    Simpan Seluruh Pengaturan Display & Tarkhim
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL KUSTOM KONFIRMASI HAPUS AUDIO         -->
<!-- ========================================== -->
<div id="deleteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 transform scale-95 transition-transform duration-300" id="deleteModalContent">
        <div class="text-center space-y-3">
            <div class="w-14 h-14 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto text-2xl">
                ⚠️
            </div>
            <h3 class="text-lg font-black text-slate-900">Hapus File Audio?</h3>
            <p class="text-xs text-slate-500 leading-relaxed" id="deleteModalText">
                Apakah Anda yakin ingin menghapus file audio ini dari server?
            </p>
        </div>
        <div class="flex gap-3 mt-6">
            <button type="button" onclick="closeDeleteModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-slate-700 font-bold py-2.5 rounded-xl text-sm transition">
                Batal
            </button>
            <button type="button" id="confirmDeleteBtn" onclick="executeDeleteAjax()" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-xl text-sm transition text-center flex items-center justify-center">
                Ya, Hapus
            </button>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- POPUP NOTIFIKASI SUKSES SIMPAN DATA         -->
<!-- ========================================== -->
<% if (success) { %>
<div id="successModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 transform scale-95 transition-transform duration-300" id="successModalContent">
        <div class="text-center space-y-3">
            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl">
                ✅
            </div>
            <h3 class="text-lg font-black text-slate-900">Berhasil Disimpan!</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
                Seluruh pengaturan display dan modul sholat berhasil diperbarui ke database.
            </p>
        </div>
        <div class="mt-6">
            <button type="button" onclick="closeSuccessModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-sm transition shadow-md">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>
<% } %>

<!-- ========================================== -->
<!-- OVERLAY LOADING SAAT MENYIMPAN DATA/FILE    -->
<!-- ========================================== -->
<div id="uploadLoadingOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-8 max-w-xs w-full mx-4 shadow-2xl border border-gray-100 text-center space-y-4">
        <div class="relative w-16 h-16 mx-auto">
            <div class="absolute inset-0 border-4 border-emerald-200 rounded-full animate-pulse"></div>
            <div class="absolute inset-0 border-4 border-emerald-600 rounded-full animate-spin border-t-transparent"></div>
            <div class="absolute inset-0 flex items-center justify-center text-xl">🕌</div>
        </div>
        <div>
            <h3 class="text-base font-black text-slate-900">Menyimpan & Mengunggah...</h3>
            <p class="text-xs text-slate-500 mt-1">Mohon tunggu, file audio sedang dikirim ke server.</p>
        </div>
    </div>
</div>

<!-- SCRIPT JAVASCRIPT DINAMIS PER SHOLAT -->
<script>
    let selectedAudioId = null;
    let selectedIdSholat = null;

    // 1. Fungsi Modal Hapus
    function openDeleteModal(audioId, fileName, idSholat) {
        selectedAudioId = audioId;
        selectedIdSholat = idSholat;
        
        const modal = document.getElementById('deleteModal');
        const content = document.getElementById('deleteModalContent');
        const textDesc = document.getElementById('deleteModalText');

        textDesc.innerHTML = `Apakah Anda yakin ingin menghapus file <strong class="text-slate-800">"${fileName}"</strong> dari server?`;

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }, 10);
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        const content = document.getElementById('deleteModalContent');

        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
            selectedAudioId = null;
            selectedIdSholat = null;
        }, 300);
    }

    // 2. Eksekusi Hapus AJAX Per Sholat
    async function executeDeleteAjax() {
        if (!selectedAudioId) return;

        const audioId = selectedAudioId;
        const idSholat = selectedIdSholat;
        closeDeleteModal();

        try {
            const response = await fetch(`/admin/display/tarkhim/delete/${audioId}`);
            const result = await response.json();

            if (result.success) {
                const rowItem = document.getElementById(`audio-row-${audioId}`);
                if (rowItem) rowItem.remove();

                const remainingAudioForThisSholat = result.tarkhimList.filter(a => a.id_sholat == idSholat);
                const container = document.getElementById(`audioListContainer_${idSholat}`);

                if (remainingAudioForThisSholat.length === 0) {
                    container.innerHTML = `<p class="text-[11px] text-gray-400 italic" id="emptyAudioText_${idSholat}">Belum ada file audio tarkhim untuk waktu ini.</p>`;
                    const tarkhimDetikInput = document.getElementById(`prep_tarkhim_detik_${idSholat}`);
                    if (tarkhimDetikInput) tarkhimDetikInput.value = 0;
                    return;
                }

                let totalSeconds = 0;
                for (const audio of remainingAudioForThisSholat) {
                    const fileUrl = `/uploads/tarkhim/${audio.filename}`;
                    try {
                        const duration = await getAudioUrlDuration(fileUrl);
                        totalSeconds += duration;
                    } catch (e) {
                        totalSeconds += 300;
                    }
                }

                if (totalSeconds > 0) {
                    let totalDetik = Math.round(totalSeconds);
                    const tarkhimDetikInput = document.getElementById(`prep_tarkhim_detik_${idSholat}`);
                    if (tarkhimDetikInput) tarkhimDetikInput.value = totalDetik;
                }

            } else {
                alert("Gagal menghapus file audio.");
            }
        } catch (err) {
            console.error("Terjadi kesalahan:", err);
            alert("Gagal terhubung ke server.");
        }
    }

    function getAudioUrlDuration(url) {
        return new Promise((resolve) => {
            const audio = new Audio();
            audio.src = url;
            audio.onloadedmetadata = function() { resolve(audio.duration); };
            audio.onerror = function() { resolve(300); };
        });
    }

    // Pop-up Sukses
    <% if (success) { %>
        window.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('successModal');
            const content = document.getElementById('successModalContent');
            if (modal) {
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                }, 10);
            }
        });
    <% } %>

    function closeSuccessModal() {
        const modal = document.getElementById('successModal');
        const content = document.getElementById('successModalContent');
        if (modal) {
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                window.history.replaceState({}, document.title, window.location.pathname);
            }, 300);
        }
    }

    // 3. Kalkulasi Otomatis Durasi File Baru Per Sholat (id_sholat 1 s/d 5)
    document.addEventListener('DOMContentLoaded', function() {
        for (let i = 1; i <= 6; i++) {
            const fileInput = document.querySelector(`input[name="tarkhim_files_${i}"]`);
            const tarkhimDetikInput = document.getElementById(`prep_tarkhim_detik_${i}`);

            if (fileInput && tarkhimDetikInput) {
                fileInput.addEventListener('change', async function(event) {
                    const files = event.target.files;
                    if (!files || files.length === 0) return;

                    const emptyText = document.getElementById(`emptyAudioText_${i}`);
                    let totalSeconds = 0;

                    if (!emptyText) {
                        totalSeconds = parseInt(tarkhimDetikInput.value) || 0;
                    } else {
                        totalSeconds = 0;
                    }

                    for (let j = 0; j < files.length; j++) {
                        const file = files[j];
                        const fileUrl = URL.createObjectURL(file);
                        try {
                            const duration = await getAudioFileDuration(fileUrl);
                            totalSeconds += duration;
                        } catch (e) {
                            totalSeconds += 300;
                        }
                    }

                    if (totalSeconds > 0) {
                        tarkhimDetikInput.value = Math.round(totalSeconds);
                        console.log(`Durasi tarkhim sholat ID ${i} diperbarui: ${Math.round(totalSeconds)} detik.`);
                    }
                });
            }
        }

        function getAudioFileDuration(url) {
            return new Promise((resolve) => {
                const audio = new Audio();
                audio.src = url;
                audio.onloadedmetadata = function() { resolve(audio.duration); };
                audio.onerror = function() { resolve(300); };
            });
        }

        // Loading overlay form submit
        const form = document.querySelector('form[action="/admin/display/settings/update"]');
        const loadingOverlay = document.getElementById('uploadLoadingOverlay');

        if (form && loadingOverlay) {
            form.addEventListener('submit', function() {
                loadingOverlay.classList.remove('hidden');
                setTimeout(() => {
                    loadingOverlay.classList.remove('opacity-0');
                }, 10);
            });
        }
    });
</script>

<%- include('../partials/footer') %>