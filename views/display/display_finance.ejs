<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Display Keuangan - <%= appSettings.mosque_name || 'MyMosque' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #011c16; }
        ::-webkit-scrollbar { display: none; }
        
        .islamic-lux-frame {
            border: 4px md:border-8 double #fbbf24;
            box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.7), 0 0 30px rgba(245, 158, 11, 0.25);
            position: relative;
            background-color: #022c22;
            background-image: 
                radial-gradient(rgba(251, 191, 36, 0.18) 2px, transparent 2px),
                radial-gradient(rgba(251, 191, 36, 0.1) 2px, transparent 2px);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
        }

        .corner-ornament {
            position: absolute;
            width: 60px; height: 60px;
            md:width: 90px; md:height: 90px;
            border-color: #fbbf24; border-style: double;
            pointer-events: none; z-index: 20;
            background: radial-gradient(circle, rgba(251,191,36,0.2) 0%, transparent 70%);
        }

        .finance-card {
            border: 2px solid rgba(251, 191, 36, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body class="min-h-screen md:h-screen w-screen overflow-x-hidden md:overflow-hidden text-white relative flex flex-col islamic-lux-frame">
    <!-- HEADER UTAMA -->
    <header class="bg-slate-950/85 backdrop-blur-md shadow-2xl flex-shrink-0 z-10 border-b-2 md:border-b-4 border-amber-400/80 px-4 md:px-8 py-4 md:py-6 flex flex-col md:flex-row justify-between items-center gap-3 md:gap-0">
        
        <div class="flex items-center gap-3 md:gap-5 w-full md:w-auto">
            <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center overflow-hidden flex-shrink-0 bg-slate-900 rounded-xl md:rounded-2xl border-2 border-amber-400/50 shadow-inner">
                <% if (typeof appSettings !== 'undefined' && appSettings.logo) { %>
                    <img src="/uploads/<%= appSettings.logo %>" alt="Logo" class="w-full h-full object-contain p-1">
                <% } else { %>
                    <span class="text-3xl">🕌</span>
                <% } %>
            </div>
            <div>
                <h1 class="text-xl text-center md:text-3xl lg:text-4xl font-black tracking-wider uppercase text-amber-300 drop-shadow-md">
                    TRANSPARANSI KAS <%= (typeof appSettings !== 'undefined' && appSettings.mosque_name) ? appSettings.mosque_name : 'undefined' %>
                </h1>
                
                <div class="flex items-center gap-2 mt-1.5">
                    <span id="pingDot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
                    <select id="dropdownPeriode" onchange="gantiPeriodeDisplay(this.value)" class="bg-slate-900 text-emerald-300 font-extrabold text-xs md:text-sm uppercase tracking-wide px-3 py-1 rounded-lg border border-emerald-500/50 outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer shadow-inner">
                        <option value="" class="bg-slate-900 text-white">Memuat Periode...</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="text-left md:text-right bg-slate-900/90 px-4 md:px-5 py-2 rounded-xl border border-amber-400/40 shadow-xl w-full md:w-auto flex md:flex-col justify-between items-center md:items-end">
            <h2 class="text-xl md:text-2xl font-extrabold text-white tracking-wide" id="tanggalMasehi">Memuat...</h2>
            <div class="flex items-center gap-1.5 mt-0.5">
                <span class="w-2 h-2 rounded-full bg-amber-400" id="statusDot"></span>
                <p class="text-amber-300 font-bold text-xs tracking-wider uppercase" id="statusKoneksi">Live Online</p>
            </div>
        </div>
    </header>

    <!-- KONTEN UTAMA -->
    <main class="flex-grow flex flex-col justify-between px-4 md:px-8 py-4 md:py-5 z-10 overflow-y-auto md:overflow-hidden gap-4">
        
        <!-- KARTU STATISTIK KAS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5" id="statistikContainer">
            <!-- Diisi JavaScript -->
        </div>

        <!-- TABEL LIVE PREVIEW TRANSAKSI -->
        <div class="bg-slate-950/80 rounded-2xl md:rounded-3xl shadow-2xl border border-amber-400/30 overflow-hidden flex flex-col h-72 md:h-auto md:flex-grow backdrop-blur-md">
            <div class="px-4 md:px-6 py-3 border-b border-amber-400/20 bg-slate-900/90 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <span class="text-amber-400 text-sm md:text-base">📋</span>
                    <h3 class="font-extrabold text-amber-200 text-xs md:text-base uppercase tracking-wider">10 Transaksi Terbaru Bulan Ini</h3>
                </div>
                <!-- Badge Auto Sync Statis (Tanpa Animasi Ping/Pulse) -->
                <span id="badgeStatusSync" class="text-[10px] md:text-xs text-emerald-300 font-bold bg-emerald-950 px-2.5 py-1 rounded-full border border-emerald-500/40 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-emerald-400"></span> Auto-Sync Real-time
                </span>
            </div>
            <div class="overflow-x-auto flex-grow">
                <table class="w-full text-left border-collapse min-w-[600px] md:min-w-full">
                    <thead>
                        <tr class="bg-slate-900/90 text-amber-300/90 text-[11px] md:text-xs font-black uppercase tracking-wider border-b border-amber-400/20">
                            <th class="p-3.5 md:p-4">Tanggal</th>
                            <th class="p-3.5 md:p-4">Jenis Transaksi</th>
                            <th class="p-3.5 md:p-4">Kategori & Keterangan</th>
                            <th class="p-3.5 md:p-4 text-right">Nominal (Rp)</th>
                        </tr>
                    </thead>
                    <tbody id="tabel-transaksi-body" class="divide-y divide-slate-800/80 text-xs md:text-sm text-slate-100">
                        <tr><td colspan="4" class="p-6 text-center text-slate-400 italic font-medium">Memuat data transaksi...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        let refreshInterval = null;
        let selectedPeriodeId = "";

        function formatUang(angka) {
            return new Intl.NumberFormat('id-ID').format(angka);
        }

        function formatTanggal(tanggalStr) {
            if (!tanggalStr) return '-';
            const parts = tanggalStr.split('-');
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        // Fungsi pemicu saat opsi dropdown dipilih
        function gantiPeriodeDisplay(val) {
            selectedPeriodeId = val;
            fetchDisplayFinanceData();
        }

        async function fetchDisplayFinanceData() {
            try {
                let url = '/api/display-finance-data';
                
                // Tambahkan parameter bulan dan tahun ke URL jika ada pilihan dari dropdown
                if (selectedPeriodeId) {
                    const [bulan, tahun] = selectedPeriodeId.split('-');
                    url += `?bulan=${bulan}&tahun=${tahun}`;
                }

                const response = await fetch(url);
                const data = await response.json();

                if (data.error) throw new Error("Gagal mengambil data");

                // 1. Render Dropdown Periode (Diisi dengan daftar arsip dari server)
                const dropdown = document.getElementById('dropdownPeriode');
                if (data.semuaPeriode && data.semuaPeriode.length > 0) {
                    let optionsHTML = '';
                    data.semuaPeriode.forEach(p => {
                        optionsHTML += `<option value="${p.id}" class="bg-slate-900 text-white">${p.label}</option>`;
                    });
                    dropdown.innerHTML = optionsHTML;
                }

                // Pertahankan posisi opsi dropdown sesuai yang sedang dilihat pengguna
                if (selectedPeriodeId) {
                    dropdown.value = selectedPeriodeId;
                } else if (data.semuaPeriode && data.semuaPeriode.length > 0) {
                    dropdown.value = data.semuaPeriode[0].id; // Default aktif (bulan berjalan)
                }

                // 2. Set Status Koneksi & Auto-Refresh Cerdas (Tanpa Animasi Kedip)
                document.getElementById('statusKoneksi').innerText = data.isActive ? "Live Online" : "Arsip (Selesai)";
                document.getElementById('statusDot').className = data.isActive ? "w-2 h-2 rounded-full bg-amber-400" : "w-2 h-2 rounded-full bg-slate-400";
                
                if (!data.isActive) {
                    // Matikan polling (auto-refresh) jika user sedang melihat arsip bulan lalu
                    if (refreshInterval) {
                        clearInterval(refreshInterval);
                        refreshInterval = null;
                    }
                    document.getElementById('badgeStatusSync').innerHTML = `<span class="text-slate-400">Mode Arsip (Statik)</span>`;
                    document.getElementById('pingDot').className = "w-2.5 h-2.5 rounded-full bg-slate-500 flex-shrink-0";
                } else {
                    // Nyalakan kembali polling jika user kembali ke bulan aktif
                    if (!refreshInterval) {
                        refreshInterval = setInterval(fetchDisplayFinanceData, 5000);
                    }
                    document.getElementById('badgeStatusSync').innerHTML = `<span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-emerald-400"></span> Auto-Sync Real-time`;
                    document.getElementById('pingDot').className = "w-2.5 h-2.5 rounded-full bg-emerald-400 flex-shrink-0";
                }

                // 3. Render 4 Kartu Jumbo Keuangan
                const cardsHTML = `
                    <!-- Saldo Awal -->
                    <div class="finance-card rounded-3xl p-7 md:p-10 flex flex-col justify-between relative overflow-hidden bg-gradient-to-br from-slate-800 to-slate-900 border-2 border-slate-700">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-8xl md:text-9xl select-none">🏦</div>
                        <span class="text-base md:text-lg font-black uppercase tracking-wider text-slate-300 drop-shadow-md">Saldo Awal Bulan</span>
                        <div class="mt-5 md:mt-7 bg-slate-950/70 p-5 md:p-6 rounded-2xl border border-slate-600 shadow-inner">
                            <strong class="text-white text-2xl md:text-4xl font-black tracking-tight">Rp ${formatUang(data.saldoAwal)}</strong>
                        </div>
                    </div>
                    
                    <!-- Kas Masuk -->
                    <div class="finance-card rounded-3xl p-7 md:p-10 flex flex-col justify-between relative overflow-hidden bg-gradient-to-br from-emerald-950/95 via-teal-950/90 to-slate-950/95 border-2 border-emerald-500/60">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-8xl md:text-9xl select-none">📥</div>
                        <span class="text-base md:text-lg font-black uppercase tracking-wider text-emerald-300 drop-shadow-md">Total Kas Masuk</span>
                        <div class="mt-5 md:mt-7 bg-slate-950/70 p-5 md:p-6 rounded-2xl border border-emerald-700/60 shadow-inner">
                            <strong class="text-emerald-400 text-2xl md:text-4xl font-black tracking-tight">+ Rp ${formatUang(data.totalMasuk)}</strong>
                        </div>
                    </div>

                    <!-- Kas Keluar -->
                    <div class="finance-card rounded-3xl p-7 md:p-10 flex flex-col justify-between relative overflow-hidden bg-gradient-to-br from-rose-950/95 via-red-950/90 to-slate-950/95 border-2 border-rose-500/60">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-8xl md:text-9xl select-none">📤</div>
                        <span class="text-base md:text-lg font-black uppercase tracking-wider text-rose-300 drop-shadow-md">Total Kas Keluar</span>
                        <div class="mt-5 md:mt-7 bg-slate-950/70 p-5 md:p-6 rounded-2xl border border-rose-700/60 shadow-inner">
                            <strong class="text-rose-400 text-2xl md:text-4xl font-black tracking-tight">- Rp ${formatUang(data.totalKeluar)}</strong>
                        </div>
                    </div>

                    <!-- Saldo Akhir -->
                    <div class="finance-card rounded-3xl p-7 md:p-10 flex flex-col justify-between relative overflow-hidden border-2 border-amber-400/90 bg-gradient-to-br from-amber-600/95 via-yellow-600/95 to-amber-700/95 shadow-2xl">
                        <div class="absolute -right-4 -bottom-4 opacity-20 text-8xl md:text-9xl select-none">💰</div>
                        <span class="text-base md:text-lg font-black uppercase tracking-wider text-amber-100 drop-shadow-md">Saldo Kas Saat Ini</span>
                        <div class="mt-5 md:mt-7 bg-slate-950/40 p-5 md:p-6 rounded-2xl border border-amber-300/50 shadow-inner">
                            <strong class="text-white text-3xl md:text-5xl font-black tracking-tight drop-shadow-lg">Rp ${formatUang(data.saldoAkhir)}</strong>
                        </div>
                    </div>
                `;
                document.getElementById('statistikContainer').innerHTML = cardsHTML;

                // 4. Render Tabel Transaksi
                const tbody = document.getElementById('tabel-transaksi-body');
                if (!data.transactions || data.transactions.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-slate-400 italic font-medium">Belum ada transaksi di bulan ini.</td></tr>`;
                    return;
                }

                let transaksiHTML = '';
                data.transactions.forEach(trx => {
                    const isMasuk = trx.jenis === 'masuk';
                    const nominalColor = isMasuk ? 'text-emerald-400' : 'text-rose-400';
                    const sign = isMasuk ? '+' : '-';
                    const badge = isMasuk 
                        ? `<span class="bg-emerald-950/90 text-emerald-300 px-3 py-1.5 rounded-xl font-bold border border-emerald-600/50 shadow-sm">Pemasukan</span>`
                        : `<span class="bg-rose-950/90 text-rose-300 px-3 py-1.5 rounded-xl font-bold border border-rose-600/50 shadow-sm">Pengeluaran</span>`;

                    transaksiHTML += `
                        <tr class="hover:bg-slate-900/70 transition-colors">
                            <td class="p-3.5 md:p-4 text-slate-300 text-sm md:text-lg font-mono font-bold">${formatTanggal(trx.tanggal)}</td>
                            <td class="p-3.5 md:p-4 text-sm md:text-base">${badge}</td>
                            <td class="p-3.5 md:p-4">
                                <div class="font-black text-white text-sm md:text-lg">${trx.nama_kategori || 'Transaksi'}</div>
                                <div class="text-slate-400 text-xs md:text-sm mt-1">${trx.keterangan || '-'}</div>
                            </td>
                            <td class="p-3.5 md:p-4 text-right text-lg md:text-2xl font-black ${nominalColor} tracking-wide">
                                ${sign} Rp ${formatUang(trx.jumlah)}
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = transaksiHTML;

            } catch (e) {
                document.getElementById('statusKoneksi').innerText = "Offline Mode";
                document.getElementById('statusDot').className = "w-2 h-2 rounded-full bg-red-400";
            }
        }

        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('tanggalMasehi').innerText = now.toLocaleDateString('id-ID', options);
        }

        // Inisialisasi awal saat halaman dimuat
        updateClock();
        fetchDisplayFinanceData();
        setInterval(updateClock, 1000);
    </script>
</body>
</html>