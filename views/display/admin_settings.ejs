<%- include('../partials/header') %>

<div class="max-w-4xl mx-auto p-4 md:p-6 mt-4 font-sans space-y-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 relative">
        <h1 class="text-2xl font-black text-emerald-900 mb-4">🖥️ Pengaturan Display Jadwal Sholat</h1>

        <form action="/admin/display/settings/update" method="POST" enctype="multipart/form-data" class="space-y-6">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1 pt-4 border-t">Kota / Wilayah (Jadwal Sholat Kemenag)</label>
                <input type="text" name="sholat_city" id="inputCity" value="<%= settings.sholat_city || '' %>" required class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Teks Pengumuman Berjalan</label>
                <textarea name="sholat_running_text" rows="4" class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none"><%= settings.sholat_running_text || '' %></textarea>
            </div>

            <!-- PERSIAPAN ADZAN -->
            <h3 class="text-lg font-bold text-gray-800 pt-4 border-t">Hitung Mundur Menjelang Adzan (Dalam Detik)</h3>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Subuh</label><input type="number" name="prep_adzan_subuh" value="<%= settings.prep_adzan_subuh || 60 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Dzuhur</label><input type="number" name="prep_adzan_dzuhur" value="<%= settings.prep_adzan_dzuhur || 60 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Ashar</label><input type="number" name="prep_adzan_ashar" value="<%= settings.prep_adzan_ashar || 60 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Maghrib</label><input type="number" name="prep_adzan_maghrib" value="<%= settings.prep_adzan_maghrib || 60 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Isya</label><input type="number" name="prep_adzan_isya" value="<%= settings.prep_adzan_isya || 60 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
            </div>

            <!-- DURASI IQOMAH -->
            <h3 class="text-lg font-bold text-gray-800 pt-4 border-t">Durasi Hitung Mundur Iqomah (Dalam Menit)</h3>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Subuh</label><input type="number" name="iqomah_subuh" value="<%= settings.iqomah_subuh || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Dzuhur</label><input type="number" name="iqomah_dzuhur" value="<%= settings.iqomah_dzuhur || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Ashar</label><input type="number" name="iqomah_ashar" value="<%= settings.iqomah_ashar || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Maghrib</label><input type="number" name="iqomah_maghrib" value="<%= settings.iqomah_maghrib || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Isya</label><input type="number" name="iqomah_isya" value="<%= settings.iqomah_isya || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
            </div>

            <!-- DURASI SHOLAT -->
            <h3 class="text-lg font-bold text-gray-800 pt-4 border-t">Durasi Mode Sholat Berlangsung (Dalam Menit)</h3>
            <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Subuh</label><input type="number" name="sholat_duration_subuh" value="<%= settings.sholat_duration_subuh || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Dzuhur</label><input type="number" name="sholat_duration_dzuhur" value="<%= settings.sholat_duration_dzuhur || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Ashar</label><input type="number" name="sholat_duration_ashar" value="<%= settings.sholat_duration_ashar || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Maghrib</label><input type="number" name="sholat_duration_maghrib" value="<%= settings.sholat_duration_maghrib || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
                <div><label class="block text-xs font-bold text-gray-600 mb-1">Isya</label><input type="number" name="sholat_duration_isya" value="<%= settings.sholat_duration_isya || 10 %>" class="w-full border rounded-lg p-2.5 text-sm text-center"></div>
            </div>

            <h3 class="text-lg font-bold text-gray-800 pt-4 border-t">Durasi Mode Adzan & Khutbah Jum'at (Dalam Menit)</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Durasi Tampilan Mode Adzan</label>
                    <input type="number" name="durasi_adzan_menit" value="<%= settings.durasi_adzan_menit || 3 %>" class="w-full border rounded-lg p-2.5 text-sm" required>
                    <p class="text-[10px] text-gray-400 mt-1">Lama layar berkedip hijau menampilkan adzan (biasanya 3 menit).</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-1">Durasi Khutbah Jum'at</label>
                    <input type="number" name="durasi_khutbah_menit" value="<%= settings.durasi_khutbah_menit || 45 %>" class="w-full border rounded-lg p-2.5 text-sm" required>
                    <p class="text-[10px] text-gray-400 mt-1">Lama layar menampilkan imbauan khutbah khusus hari Jumat.</p>
                </div>
            </div>

            <!-- BAGIAN MANAJEMEN AUDIO TARKHIM -->
            <h3 class="text-lg font-bold text-gray-800 pt-6 border-t">🎵 Manajemen Audio Tarkhim</h3>
            <div class="bg-gray-50 p-4 rounded-xl border border-gray-200 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-gray-600 mb-2">Pilih File Audio Baru (Bisa lebih dari 1 file):</label>
                    <input type="file" name="tarkhim_files" accept="audio/mp3,audio/wav,audio/mpeg" multiple class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100">
                    <p class="text-[11px] text-gray-400 mt-1">File akan tersimpan ke server dan database ketika tombol Simpan di bawah diklik.</p>
                </div>

                <!-- Daftar File yang Sudah Di-upload -->
                <div class="mt-4 space-y-2">
                    <h4 class="text-xs font-black uppercase text-gray-600 tracking-wider">Daftar Audio:</h4>
                    <% if (tarkhimList && tarkhimList.length > 0) { %>
                        <ul class="divide-y divide-gray-200 bg-white rounded-xl border border-gray-200 overflow-hidden">
                            <% tarkhimList.forEach(audio => { %>
                                <li class="px-4 py-3 flex justify-between items-center text-sm">
                                    <div class="flex items-center gap-3">
                                        <span>▶️</span>
                                        <span class="font-medium text-gray-700"><%= audio.original_name %></span>
                                    </div>
                                    <!-- TOMBOL HAPUS MENGAKTIFKAN MODAL KUSTOM -->
                                    <button type="button" onclick="openDeleteModal('/admin/display/tarkhim/delete/<%= audio.id %>', '<%= audio.original_name %>')" class="text-red-500 hover:text-red-700 font-bold text-xs bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-lg transition">Hapus</button>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="text-xs text-gray-400 italic">Belum ada file audio tarkhim yang di-upload.</p>
                    <% } %>
                </div>

                <!-- PENGATURAN WAKTU TARKHIM -->
                <h3 class="text-lg font-bold text-gray-800 pt-6 border-t">⏰ Pengaturan Waktu Putar Tarkhim Otomatis</h3>
                <div class="bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <label class="block text-xs font-bold text-gray-600 mb-1">Mulai Putar Tarkhim Sebelum Adzan (Dalam Menit)</label>
                    <input type="number" name="prep_tarkhim_menit" value="<%= settings.prep_tarkhim_menit || 15 %>" class="w-full md:w-1/3 border rounded-lg p-2.5 text-sm" required>
                    <p class="text-[11px] text-gray-400 mt-1">Audio tarkhim akan otomatis mulai berputar sekian menit sebelum waktu adzan tiba (meskipun layar TV masih menampilkan mode normal/pengumuman).</p>
                </div>
            </div>

            <div class="pt-4">
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 rounded-xl transition shadow-lg">
                    Simpan Seluruh Pengaturan Display
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. MODAL KUSTOM KONFIRMASI HAPUS AUDIO     -->
<!-- ========================================== -->
<div id="deleteModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 transform scale-95 transition-transform duration-300" id="deleteModalContent">
        <div class="text-center space-y-3">
            <div class="w-14 h-14 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto text-2xl">
                ⚠️
            </div>
            <h3 class="text-lg font-black text-slate-900">Hapus File Audio?</h3>
            <p class="text-xs text-slate-500 leading-relaxed" id="deleteModalText">
                Apakah Anda yakin ingin menghapus file audio ini dari server?
            </p>
        </div>
        <div class="flex gap-3 mt-6">
            <button type="button" onclick="closeDeleteModal()" class="flex-1 bg-gray-100 hover:bg-gray-200 text-slate-700 font-bold py-2.5 rounded-xl text-sm transition">
                Batal
            </button>
            <a id="confirmDeleteBtn" href="#" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-2.5 rounded-xl text-sm transition text-center flex items-center justify-center">
                Ya, Hapus
            </a>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 2. POPUP NOTIFIKASI SUKSES SIMPAN DATA      -->
<!-- ========================================== -->
<% if (success) { %>
<div id="successModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center opacity-0 transition-opacity duration-300">
    <div class="bg-white rounded-3xl p-6 max-w-sm w-full mx-4 shadow-2xl border border-gray-100 transform scale-95 transition-transform duration-300" id="successModalContent">
        <div class="text-center space-y-3">
            <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-2xl">
                ✅
            </div>
            <h3 class="text-lg font-black text-slate-900">Berhasil Disimpan!</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
                Seluruh pengaturan display dan modul sholat berhasil diperbarui ke database.
            </p>
        </div>
        <div class="mt-6">
            <button type="button" onclick="closeSuccessModal()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl text-sm transition shadow-md">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>
<% } %>

<!-- SCRIPT PENGATUR MODAL -->
<script>
    // Fungsi untuk memunculkan modal hapus
    function openDeleteModal(deleteUrl, fileName) {
        const modal = document.getElementById('deleteModal');
        const content = document.getElementById('deleteModalContent');
        const confirmBtn = document.getElementById('confirmDeleteBtn');
        const textDesc = document.getElementById('deleteModalText');

        textDesc.innerHTML = `Apakah Anda yakin ingin menghapus file <strong class="text-slate-800">"${fileName}"</strong> dari server?`;
        confirmBtn.href = deleteUrl;

        modal.classList.remove('hidden');
        setTimeout(() => {
            modal.classList.remove('opacity-0');
            content.classList.remove('scale-95');
            content.classList.add('scale-100');
        }, 10);
    }

    // Fungsi untuk menutup modal hapus
    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        const content = document.getElementById('deleteModalContent');

        modal.classList.add('opacity-0');
        content.classList.remove('scale-100');
        content.classList.add('scale-95');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 300);
    }

    // Otomatis munculkan popup sukses jika variabel success bernilai true dari backend
    <% if (success) { %>
        window.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('successModal');
            const content = document.getElementById('successModalContent');
            if (modal) {
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                }, 10);
            }
        });
    <% } %>

    // Fungsi untuk menutup popup sukses
    function closeSuccessModal() {
        const modal = document.getElementById('successModal');
        const content = document.getElementById('successModalContent');
        if (modal) {
            modal.classList.add('opacity-0');
            content.classList.remove('scale-100');
            content.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                // Bersihkan URL parameter success agar kalau di-refresh tidak muncul lagi popupsnya (opsional)
                window.history.replaceState({}, document.title, window.pathnam || window.location.pathname);
            }, 300);
        }
    }
</script>

<%- include('../partials/footer') %>