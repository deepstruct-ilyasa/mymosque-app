<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Display Zakat - <%= appSettings.mosque_name || 'MyMosque' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #011c16; }
        ::-webkit-scrollbar { display: none; }
        
        .islamic-lux-frame {
            border: 4px md:border-8 double #fbbf24;
            box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.7), 0 0 30px rgba(245, 158, 11, 0.25);
            position: relative;
            background-color: #022c22;
            background-image: 
                radial-gradient(rgba(251, 191, 36, 0.18) 2px, transparent 2px),
                radial-gradient(rgba(251, 191, 36, 0.1) 2px, transparent 2px);
            background-size: 40px 40px;
            background-position: 0 0, 20px 20px;
        }

        .corner-ornament {
            position: absolute;
            width: 60px; height: 60px;
            md:width: 90px; md:height: 90px;
            border-color: #fbbf24; border-style: double;
            pointer-events: none; z-index: 20;
            background: radial-gradient(circle, rgba(251,191,36,0.2) 0%, transparent 70%);
        }

        .zakat-card {
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(2, 44, 34, 0.95) 100%);
            border: 2px solid rgba(251, 191, 36, 0.4);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body class="min-h-screen md:h-screen w-screen overflow-x-hidden md:overflow-hidden text-white relative flex flex-col islamic-lux-frame">
    <!-- HEADER UTAMA -->
    <header class="bg-slate-950/85 backdrop-blur-md shadow-2xl flex-shrink-0 z-10 border-b-2 md:border-b-4 border-amber-400/80 px-4 md:px-8 py-4 md:py-6 flex flex-col md:flex-row justify-between items-center gap-3 md:gap-0">
        
        <!-- KIRI: LOGO & JUDUL BESERTA DROPDOWN AGENDA DI BAWAHNYA -->
        <div class="flex items-center gap-3 md:gap-5 w-full md:w-auto">
            <div class="w-16 h-16 md:w-20 md:h-20 flex items-center justify-center overflow-hidden flex-shrink-0 bg-slate-900 rounded-xl md:rounded-2xl border-2 border-amber-400/50 shadow-inner">
                <% if (typeof appSettings !== 'undefined' && appSettings.logo) { %>
                    <img src="/uploads/<%= appSettings.logo %>" alt="Logo" class="w-full h-full object-contain p-1">
                <% } else { %>
                    <svg class="w-7 h-7 md:w-9 md:h-9 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L9 7h6l-3-5zm-5 7a2 2 0 00-2 2v9a2 2 0 002 2h10a2 2 0 002-2v-9a2 2 0 00-2-2H7z"/></svg>
                <% } %>
            </div>
            <div>
                <h1 class="text-xl text-center md:text-3xl lg:text-4xl font-black tracking-wider uppercase text-amber-300 drop-shadow-md">
                    REKAPITULASI ZAKAT <%= (typeof appSettings !== 'undefined' && appSettings.mosque_name) ? appSettings.mosque_name : 'undefined' %>
                </h1>
                
                <!-- Sub-judul interaktif: Titik statis (tanpa animasi ping) + Dropdown Agenda -->
                <div class="flex items-center gap-2 mt-1.5">
                    <span id="pingDot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 flex-shrink-0"></span>
                    <select id="dropdownAgenda" onchange="gantiAgendaDisplay(this.value)" class="bg-slate-900 text-amber-300 font-extrabold text-xs md:text-sm uppercase tracking-wide px-3 py-1 rounded-lg border border-emerald-500/50 outline-none focus:ring-2 focus:ring-amber-400 cursor-pointer shadow-inner">
                        <option value="" class="bg-slate-900 text-white">Memuat Agenda...</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- KANAN: JAM & STATUS KONEKSI (Hanya Jam & Status Saja) -->
        <div class="text-left md:text-right bg-slate-900/90 px-4 md:px-5 py-2 rounded-xl border border-amber-400/40 shadow-xl w-full md:w-auto flex md:flex-col justify-between items-center md:items-end">
            <h2 class="text-xl md:text-2xl font-extrabold text-white tracking-wide" id="tanggalMasehi">Memuat...</h2>
            <div class="flex items-center gap-1.5 mt-0.5">
                <span class="w-2 h-2 rounded-full bg-amber-400" id="statusDot"></span>
                <p class="text-amber-300 font-bold text-xs tracking-wider uppercase" id="statusKoneksi">Live Online</p>
            </div>
        </div>

    </header>

    <!-- KONTEN UTAMA -->
    <main class="flex-grow flex flex-col justify-between px-4 md:px-8 py-4 md:py-5 z-10 overflow-y-auto md:overflow-hidden gap-4">
        
        <!-- KARTU STATISTIK 4 KATEGORI -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5" id="statistikContainer"></div>

        <!-- TABEL LIVE PREVIEW TRANSAKSI -->
        <div class="bg-slate-950/80 rounded-2xl md:rounded-3xl shadow-2xl border border-amber-400/30 overflow-hidden flex flex-col h-72 md:h-auto md:flex-grow backdrop-blur-md">
            <div class="px-4 md:px-6 py-3 border-b border-amber-400/20 bg-slate-900/90 flex justify-between items-center">
                <div class="flex items-center gap-2">
                    <span class="text-amber-400 text-sm md:text-base">📋</span>
                    <h3 class="font-extrabold text-amber-200 text-xs md:text-base uppercase tracking-wider">Daftar Transaksi Masuk</h3>
                </div>
                <!-- Badge status sync tanpa animasi pulse -->
                <span id="badgeStatusSync" class="text-[10px] md:text-xs text-emerald-300 font-bold bg-emerald-950 px-2.5 py-1 rounded-full border border-emerald-500/40 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-emerald-400"></span> Auto-Sync Real-time
                </span>
            </div>
            <div class="overflow-x-auto flex-grow">
                <table class="w-full text-left border-collapse min-w-[600px] md:min-w-full">
                    <thead>
                        <tr class="bg-slate-900/90 text-amber-300/90 text-[11px] md:text-xs font-black uppercase tracking-wider border-b border-amber-400/20">
                            <th class="p-3">Waktu</th>
                            <th class="p-3">Nama Muzakki</th>
                            <th class="p-3">Jenis Zakat</th>
                            <th class="p-3">Metode</th>
                            <th class="p-3 text-center">Jumlah</th>
                            <th class="p-3 text-right">Beras</th>
                            <th class="p-3 text-right">Uang</th>
                        </tr>
                    </thead>
                    <tbody id="tabel-transaksi-body" class="divide-y divide-slate-800/80 text-xs md:text-sm text-slate-100">
                        <tr><td colspan="7" class="p-6 text-center text-slate-400 italic font-medium">Memuat data transaksi...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <script>
        let refreshInterval = null;
        let selectedEventIdFromDropdown = "";

        function formatKgJS(angka) {
            if (angka === null || angka === undefined || isNaN(angka)) return "0";
            return new Intl.NumberFormat('id-ID', { maximumFractionDigits: 3, useGrouping: false }).format(angka);
        }

        function formatWaktuJS(utcString) {
            if (!utcString) return '-';
            const userTimeZone = '<%= (typeof appSettings !== "undefined" && appSettings.timezone) ? appSettings.timezone : "Asia/Jakarta" %>';
            const date = new Date(utcString.replace(' ', 'T') + 'Z');
            return new Intl.DateTimeFormat('id-ID', {
                timeZone: userTimeZone, year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false
            }).format(date).replace(/\./g, ':');
        }

        function gantiAgendaDisplay(eventId) {
            selectedEventIdFromDropdown = eventId;
            fetchDisplayZakatData();
        }

        async function fetchDisplayZakatData() {
            try {
                let url = '/api/display-zakat-data';
                if (selectedEventIdFromDropdown) {
                    url += `?event_id=${selectedEventIdFromDropdown}`;
                }

                const response = await fetch(url);
                const data = await response.json();

                if (data.error || !data.eventPilihan) {
                    document.getElementById('statusKoneksi').innerText = "Belum Ada Agenda";
                    document.getElementById('statusDot').className = "w-2 h-2 rounded-full bg-red-400";
                    return;
                }

                // Render Opsi Dropdown di Sub-Judul (Hanya diisi sekali atau saat data siap)
                const dropdown = document.getElementById('dropdownAgenda');
                if (data.semuaEvent && data.semuaEvent.length > 0) {
                    let optionsHTML = '';
                    data.semuaEvent.forEach(ev => {
                        // Beri class background gelap agar teks opsi terbaca jelas
                        optionsHTML += `<option value="${ev.id}" class="bg-slate-900 text-white">${ev.nama_event} (${ev.status})</option>`;
                    });
                    dropdown.innerHTML = optionsHTML;
                }

                // 2. Set nilai dropdown sesuai event yang sedang aktif atau dipilih user
                if (selectedEventIdFromDropdown) {
                    dropdown.value = selectedEventIdFromDropdown;
                } else if (data.eventPilihan) {
                    dropdown.value = data.eventPilihan.id;
                }

                const isActive = (data.eventPilihan.status === 'Aktif');
                document.getElementById('statusKoneksi').innerText = isActive ? "Live Online" : "Arsip (Selesai)";
                document.getElementById('statusDot').className = isActive ? "w-2 h-2 rounded-full bg-amber-400" : "w-2 h-2 rounded-full bg-slate-400";

                // Logika Auto-Refresh (Hanya aktif jika status event 'Aktif') tanpa animasi kedip
                if (!isActive) {
                    if (refreshInterval) {
                        clearInterval(refreshInterval);
                        refreshInterval = null;
                    }
                    document.getElementById('badgeStatusSync').innerHTML = `<span class="text-slate-400">Mode Arsip (Statik)</span>`;
                    document.getElementById('pingDot').className = "w-2.5 h-2.5 rounded-full bg-slate-500 flex-shrink-0";
                } else {
                    if (!refreshInterval) {
                        refreshInterval = setInterval(fetchDisplayZakatData, 5000);
                    }
                    document.getElementById('badgeStatusSync').innerHTML = `<span class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-emerald-400"></span> Auto-Sync Real-time`;
                    document.getElementById('pingDot').className = "w-2.5 h-2.5 rounded-full bg-emerald-400 flex-shrink-0";
                }

                // 2. Render Kartu Statistik
                const jenisKategori = ['Zakat Fitrah', 'Zakat Mal', 'Infaq / Sedekah', 'Fidyah'];
                let statistikHTML = '';
                jenisKategori.forEach(namaJenis => {
                    let d = data.rekapPerJenis[namaJenis] || { jiwa: 0, beras: 0, infaqBeras: 0, uang: 0, infaqUang: 0 };
                    let satuanLabel = (namaJenis === 'Fidyah') ? 'Hari' : 'Jiwa';

                    statistikHTML += `
                    <div class="zakat-card rounded-3xl p-7 md:p-10 shadow-2xl flex flex-col justify-between relative overflow-hidden border-2 border-amber-400/60 bg-gradient-to-br from-slate-900/95 via-teal-950/90 to-slate-950/95">
                        <div class="absolute -right-4 -bottom-4 opacity-10 text-8xl md:text-9xl select-none">🕌</div>
                        <div class="flex justify-between items-center mb-5 md:mb-6">
                            <span class="text-base md:text-lg font-black uppercase tracking-wider text-amber-300 drop-shadow-md">${namaJenis}</span>
                            <span class="bg-emerald-900/95 text-emerald-200 text-sm md:text-base font-black px-4 py-2 md:px-5 md:py-2.5 rounded-2xl border-2 border-emerald-400/60 shadow-xl">
                                ${d.jiwa} ${satuanLabel}
                            </span>
                        </div>
                        <div class="space-y-4 md:space-y-5">
                            <div class="flex justify-between items-center bg-slate-900/90 p-4 md:p-5 rounded-2xl border border-slate-700/80 shadow-inner">
                                <span class="text-slate-200 font-extrabold text-sm md:text-base">Beras:</span>
                                <strong class="text-white text-xl md:text-3xl font-black tracking-tight">${formatKgJS(d.beras)} <span class="text-amber-300 text-base md:text-lg">Kg</span></strong>
                            </div>
                            <div class="flex justify-between items-center px-2 text-emerald-300 font-bold text-xs md:text-sm">
                                <span>+ Infaq Beras:</span>
                                <span class="font-extrabold">${formatKgJS(d.infaqBeras)} Kg</span>
                            </div>
                            <div class="flex justify-between items-center bg-slate-900/90 p-4 md:p-5 rounded-2xl border border-slate-700/80 shadow-inner mt-2">
                                <span class="text-slate-200 font-extrabold text-sm md:text-base">Uang:</span>
                                <strong class="text-emerald-300 text-lg md:text-2xl font-black tracking-tight">Rp ${Number(d.uang).toLocaleString('id-ID')}</strong>
                            </div>
                            <div class="flex justify-between items-center px-2 text-emerald-300 font-bold text-xs md:text-sm">
                                <span>+ Infaq Uang:</span>
                                <span class="font-extrabold">Rp ${Number(d.infaqUang).toLocaleString('id-ID')}</span>
                            </div>
                        </div>
                    </div>
                `;
                });
                document.getElementById('statistikContainer').innerHTML = statistikHTML;

                // 3. Render Tabel Live Preview Transaksi
                const tbody = document.getElementById('tabel-transaksi-body');
                if (!data.transaksi || data.transaksi.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400 italic font-medium">Belum ada transaksi tercatat pada agenda ini.</td></tr>`;
                    return;
                }

                let transaksiHTML = '';
                data.transaksi.slice(0, 10).forEach(t => {
                    let satuanRow = (t.jumlah_jiwa > 0) ? `${t.jumlah_jiwa} ${t.jenis_zakat === 'Fidyah' ? 'Hari' : 'Jiwa'}` : '-';
                    transaksiHTML += `
                        <tr class="hover:bg-slate-900/70 transition-colors">
                            <td class="p-3.5 md:p-4 text-slate-300 text-xs md:text-sm font-mono">${formatWaktuJS(t.tanggal || t.tanggal_input)}</td>
                            <td class="p-3.5 md:p-4 font-black text-white text-sm md:text-lg">${t.nama_penyetor}</td>
                            <td class="p-3.5 md:p-4"><span class="bg-emerald-950/90 text-emerald-300 text-xs md:text-sm px-3 py-1 rounded-xl font-bold border border-emerald-600/50 shadow-sm">${t.jenis_zakat}</span></td>
                            <td class="p-3.5 md:p-4"><span class="text-amber-300 font-extrabold text-xs md:text-sm uppercase tracking-wider">${t.jenis_bayar}</span></td>
                            <td class="p-3.5 md:p-4 text-center text-slate-100 font-bold text-sm md:text-base">${satuanRow}</td>
                            <td class="p-3.5 md:p-4 text-right text-sm md:text-base">
                                <span class="font-black text-amber-200">${formatKgJS(t.jumlah_beras)} Kg</span>
                                ${t.infaq_beras > 0 ? `<br><span class="text-xs md:text-sm text-emerald-400 font-semibold">+${formatKgJS(t.infaq_beras)} Kg infaq</span>` : ''}
                            </td>
                            <td class="p-3.5 md:p-4 text-right text-sm md:text-base">
                                <span class="font-black text-emerald-300">Rp ${Number(t.jumlah_uang).toLocaleString('id-ID')}</span>
                                ${t.infaq_uang > 0 ? `<br><span class="text-xs md:text-sm text-emerald-400 font-semibold">+Rp ${Number(t.infaq_uang).toLocaleString('id-ID')} infaq</span>` : ''}
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = transaksiHTML;

            } catch (e) {
                document.getElementById('statusKoneksi').innerText = "Offline Mode";
                document.getElementById('statusDot').className = "w-2 h-2 rounded-full bg-red-400";
            }
        }

        function updateClock() {
            const now = new Date();
            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            document.getElementById('tanggalMasehi').innerText = now.toLocaleDateString('id-ID', options);
        }

        updateClock();
        fetchDisplayZakatData();

        // Jalankan interval awal, nanti akan otomatis diatur aktif/mati di dalam fungsi fetch berdasarkan status event
        refreshInterval = setInterval(fetchDisplayZakatData, 5000);
        setInterval(updateClock, 1000);
    </script>
</body>
</html>