<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto p-4 md:p-6 mt-6 font-sans">
    
    <!-- HEADER, FILTER BULAN & TOMBOL TUTUP BUKU -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                <span>💰</span> Manajemen Kas Masjid
            </h1>
            <p class="text-xs text-gray-500 mt-1">Kelola dan pantau arus kas bulanan dengan sistem saldo estafet otomatis & tutup buku.</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
            <!-- STATUS TUTUP BUKU & TOMBOL AKSI -->
            <% if (isClosed) { %>
                <span class="px-3 py-2 bg-rose-100 text-rose-800 rounded-xl text-xs font-bold flex items-center gap-1 shadow-xs">
                    🔒 Periode Terkunci (Tutup Buku)
                </span>
            <% } else { %>
                <span class="px-3 py-2 bg-emerald-100 text-emerald-800 rounded-xl text-xs font-bold flex items-center gap-1 shadow-xs">
                    🟢 Periode Aktif
                </span>
                <button type="button" onclick="bukaModalTutupBuku()" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1">
                    <span>🔒</span> Tutup Buku Bulan Ini
                </button>
            <% } %>

            <!-- FORM FILTER BULAN & TAHUN -->
            <form action="/admin/finance" method="GET" id="filterForm" class="flex items-center gap-2">
                <select name="bulan" id="selectBulan" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 p-2 rounded-xl text-xs bg-white font-semibold outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer">
                    <% daftarBulan.forEach(b => { %>
                        <option value="<%= b.angka %>" <%= selectedBulan === b.angka ? 'selected' : '' %>><%= b.nama %></option>
                    <% }) %>
                </select>
                <input type="number" name="tahun" id="inputTahun" value="<%= selectedTahun %>" onchange="document.getElementById('filterForm').submit()" class="border border-gray-300 p-2 rounded-xl text-xs bg-white font-semibold w-20 text-center outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Tahun">
            </form>
        </div>
    </div>

    <!-- KARTU RINGKASAN SALDO BULANAN -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <!-- Saldo Awal (Bawaan Bulan Lalu) -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between">
            <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Saldo Awal Bulan Ini</p>
                <h3 class="text-xl font-bold text-gray-700">Rp <%= saldoAwal.toLocaleString('id-ID') %></h3>
            </div>
            <p class="text-[10px] text-gray-400 mt-2">Akumulasi sisa kas s.d. bulan lalu.</p>
        </div>

        <!-- Total Masuk Bulan Ini -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between">
            <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Kas Masuk Bulan Ini</p>
                <h3 class="text-xl font-bold text-emerald-600">+ Rp <%= totalMasuk.toLocaleString('id-ID') %></h3>
            </div>
            <p class="text-[10px] text-emerald-600 mt-2">Penerimaan kas periode ini.</p>
        </div>

        <!-- Total Keluar Bulan Ini -->
        <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm flex flex-col justify-between">
            <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 mb-1">Kas Keluar Bulan Ini</p>
                <h3 class="text-xl font-bold text-rose-600">- Rp <%= totalKeluar.toLocaleString('id-ID') %></h3>
            </div>
            <p class="text-[10px] text-rose-600 mt-2">Pengeluaran periode ini.</p>
        </div>

        <!-- Saldo Akhir -->
        <div class="bg-gradient-to-br from-emerald-600 to-teal-700 p-5 rounded-2xl text-white shadow-md flex flex-col justify-between">
            <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-emerald-100 mb-1">Total Saldo Akhir</p>
                <h3 class="text-2xl font-extrabold">Rp <%= saldoAkhir.toLocaleString('id-ID') %></h3>
            </div>
            <p class="text-[11px] text-emerald-100 mt-2">Akan menjadi saldo awal bulan depan.</p>
        </div>
    </div>

    <!-- TABEL RIWAYAT TRANSAKSI -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center">
            <h3 class="font-bold text-gray-800 text-sm">Riwayat Transaksi Bulan Ini</h3>
            <span class="text-xs bg-gray-100 text-gray-600 px-2.5 py-1 rounded-lg font-semibold"><%= transactions.length %> Transaksi tercatat</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-gray-50/70 text-gray-500 uppercase text-[10px] tracking-wider border-b border-gray-200">
                        <th class="p-4 font-bold">No</th>
                        <th class="p-4 font-bold">Tanggal</th>
                        <th class="p-4 font-bold">Jenis</th>
                        <th class="p-4 font-bold">Kategori & Keterangan</th>
                        <th class="p-4 font-bold text-right">Jumlah (Rp)</th>
                        <th class="p-4 font-bold text-center">Bukti Nota</th>
                        <th class="p-4 font-bold text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-gray-700">
                    <% if (transactions.length === 0) { %>
                        <tr>
                            <td colspan="7" class="p-8 text-center text-gray-400 italic text-xs">Belum ada data transaksi keuangan pada bulan ini.</td>
                        </tr>
                    <% } else { %>
                        <% transactions.forEach((trx, index) => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 text-gray-500 text-xs"><%= index + 1 %></td>
                                <td class="p-4 font-medium text-gray-800 whitespace-nowrap"><%= trx.tanggal %></td>
                                <td class="p-4 whitespace-nowrap">
                                    <% if (trx.jenis === 'masuk') { %>
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800">Masuk</span>
                                    <% } else { %>
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-800">Keluar</span>
                                    <% } %>
                                </td>
                                <td class="p-4 text-gray-600 text-xs max-w-[150px] md:max-w-xs break-words">
                                    <span class="font-semibold text-gray-800 block"><%= trx.nama_kategori || 'Transaksi' %></span>
                                    <span class="text-gray-500"><%= trx.keterangan || '-' %></span>
                                </td>
                                <td class="p-4 text-right font-bold whitespace-nowrap <%= trx.jenis === 'masuk' ? 'text-emerald-600' : 'text-rose-600' %>">
                                    <%= trx.jenis === 'masuk' ? '+' : '-' %> Rp <%= trx.jumlah.toLocaleString('id-ID') %>
                                </td>
                                <td class="p-4 text-center whitespace-nowrap">
                                    <% if (trx.lampiran) { %>
                                        <button type="button" onclick="bukaNotaModal('/uploads/finance/<%= trx.lampiran %>')" class="inline-flex items-center gap-1 px-2.5 py-1 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg text-xs font-bold transition">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                                            Nota
                                        </button>
                                    <% } else { %>
                                        <span class="text-xs text-gray-400 italic">-</span>
                                    <% } %>
                                </td>
                                <td class="p-4 text-center whitespace-nowrap align-middle">
                                    <div class="inline-flex items-center justify-center gap-1.5">
                                        <% if (!isClosed) { %>
                                            <a href="/admin/finance/edit/<%= trx.id %>" title="Edit Transaksi" class="p-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-600 rounded-lg transition inline-flex items-center justify-center">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                            </a>
                                            <button type="button" onclick="openDeleteModal('/admin/finance/hapus/<%= trx.id %>')" title="Hapus Transaksi" class="p-2 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition inline-flex items-center justify-center">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        <% } else { %>
                                            <span class="text-[11px] text-gray-400 italic">Terkunci</span>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL POPUP PREVIEW NOTA -->
<div id="notaModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 backdrop-blur-sm hidden p-4">
    <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] flex flex-col shadow-2xl transform transition-all scale-95 opacity-0 overflow-hidden" id="notaModalContainer">
        <div class="flex justify-between items-center px-6 py-4 border-b border-gray-100 bg-gray-50">
            <h3 class="font-bold text-gray-800 text-sm flex items-center gap-2">
                <span>📄</span> Pratinjau Bukti Transaksi / Nota
            </h3>
            <div class="flex items-center gap-2">
                <div class="flex items-center bg-white border border-gray-200 rounded-xl overflow-hidden shadow-xs">
                    <button type="button" onclick="zoomNota(-0.2)" class="px-3 py-1.5 hover:bg-gray-100 text-gray-700 text-xs font-bold transition">Zoom -</button>
                    <span id="zoomLevelText" class="px-2 text-[11px] text-gray-500 font-semibold select-none">100%</span>
                    <button type="button" onclick="zoomNota(0.2)" class="px-3 py-1.5 hover:bg-gray-100 text-gray-700 text-xs font-bold transition">Zoom +</button>
                    <button type="button" onclick="resetZoom()" class="px-2.5 py-1.5 hover:bg-gray-100 text-gray-500 text-[11px] font-semibold border-l border-gray-200 transition">Reset</button>
                </div>
                <button type="button" onclick="tutupNotaModal()" class="p-1.5 bg-gray-200 hover:bg-gray-300 text-gray-700 rounded-xl transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        </div>
        <div class="p-6 overflow-auto flex-1 flex items-center justify-center bg-gray-900/5 relative select-none">
            <div class="transition-transform duration-150 ease-out origin-center">
                <img id="notaImageSource" src="" alt="Bukti Nota Transaksi" class="max-w-full h-auto rounded-lg shadow-md block object-contain">
            </div>
        </div>
    </div>
</div>

<!-- MODAL FORM TUTUP BUKU & IDENTITAS LAPORAN -->
<div id="tutupBukuModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden overflow-y-auto p-4">
    <div class="bg-white rounded-3xl p-6 md:p-8 max-w-2xl w-full mx-auto shadow-2xl transform transition-all scale-95 opacity-0" id="tutupBukuContainer">
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <div>
                <h3 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <span>🔒</span> Proses Tutup Buku & Arsip
                </h3>
                <p class="text-xs text-gray-500 mt-1">Lengkapi data Kop Surat dan Tanda Tangan untuk mengunci laporan bulan ini.</p>
            </div>
            <button type="button" onclick="tutupModalTutupBuku()" class="p-2 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <form action="/admin/finance/tutup-buku" method="POST" enctype="multipart/form-data" class="space-y-6">
            <input type="hidden" name="bulan" value="<%= selectedBulan %>">
            <input type="hidden" name="tahun" value="<%= selectedTahun %>">
            <input type="hidden" name="logo_lama" value="<%= lastClosing.logo || '' %>">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Masjid <span class="text-rose-500">*</span></label>
                    <input type="text" name="nama_masjid" value="<%= lastClosing.nama_masjid || 'MASJID AL-MUHARRAR' %>" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Sub Judul Laporan</label>
                    <input type="text" name="sub_judul" value="<%= lastClosing.sub_judul || 'Laporan Pertanggungjawaban Keuangan' %>" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Telepon / Kontak</label>
                    <input type="text" name="telepon" value="<%= lastClosing.telepon || '' %>" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm">
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Alamat Lengkap</label>
                    <input type="text" name="alamat" value="<%= lastClosing.alamat || '' %>" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm">
                </div>
                
                <!-- LOGO MASJID & PREVIEW -->
                <div class="md:col-span-2">
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Logo Masjid / Lembaga</label>
                    <div class="flex items-center gap-4 p-3 bg-gray-50 border border-gray-200 rounded-2xl">
                        <!-- Pratinjau Logo -->
                        <div class="w-16 h-16 bg-white border border-gray-300 rounded-xl flex items-center justify-center overflow-hidden flex-shrink-0 shadow-xs">
                            <% if (lastClosing.logo) { %>
                                <!-- Jika logo ada (terambil dari app_settings.db atau arsip), tampilkan gambarnya -->
                                <img id="logoPreviewImg" src="/uploads/<%= lastClosing.logo.startsWith('logo-closing') ? 'finance/' + lastClosing.logo : lastClosing.logo %>" alt="Logo" class="w-full h-full object-contain">
                            <% } else { %>
                                <!-- Jika kosong -->
                                <span id="logoPlaceholderText" class-[10px] text-gray-400 font-bold text-center">Kosong</span>
                            <% } %>
                        </div>
                        
                        <!-- Input File & Keterangan -->
                        <div class="flex-grow">
                            <input type="file" name="logo" id="logoInputFile" accept="image/*" onchange="previewLogoBaru(event)" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white cursor-pointer">
                            <p class="text-[10px] text-gray-500 mt-1">Format: JPG, PNG. Unggah file baru jika ingin mengganti logo khusus laporan ini.</p>
                        </div>
                    </div>
                </div>

                <!-- TANDA TANGAN -->
                <!-- TANDA TANGAN KIRI (KETUA) -->
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-3">
                    <p class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider">Tanda Tangan Kiri</p>
                    
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Pilihan Jabatan</label>
                        <select id="selectJabatanKetua" onchange="handleJabatanChange('Ketua')" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white font-semibold outline-none">
                            <option value="Ketua Takmir">Ketua Takmir</option>
                            <option value="Ketua Panitia">Ketua Panitia</option>
                            <option value="Custom">Custom (Ketik Sendiri)</option>
                        </select>
                    </div>

                    <!-- Input teks jabatan custom -->
                    <div id="wrapperCustomJabatanKetua" class="hidden">
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Ketik Nama Jabatan Custom</label>
                        <input type="text" id="inputCustomJabatanKetua" placeholder="Contoh: Ketua Pembangunan" oninput="syncJabatan('Ketua')" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white">
                    </div>

                    <input type="hidden" name="jabatan_ketua" id="hiddenJabatanKetua" value="Ketua Takmir">

                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Nama Pejabat</label>
                        <input type="text" name="nama_ketua" placeholder="Contoh: H. Ahmad Fulan" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white">
                    </div>
                </div>

                <!-- TANDA TANGAN KANAN (SUBKETUA / BENDAHARA) -->
                <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 space-y-3">
                    <p class="text-[10px] font-extrabold text-gray-500 uppercase tracking-wider">Tanda Tangan Kanan</p>
                    
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Pilihan Jabatan</label>
                        <select id="selectJabatanSub" onchange="handleJabatanChange('Sub')" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white font-semibold outline-none">
                            <option value="Bendahara">Bendahara</option>
                            <option value="Sekretaris">Sekretaris</option>
                            <option value="Custom">Custom (Ketik Sendiri)</option>
                        </select>
                    </div>

                    <!-- Input teks jabatan custom -->
                    <div id="wrapperCustomJabatanSub" class="hidden">
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Ketik Nama Jabatan Custom</label>
                        <input type="text" id="inputCustomJabatanSub" placeholder="Contoh: Wakil Bendahara" oninput="syncJabatan('Sub')" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white">
                    </div>

                    <input type="hidden" name="jabatan_subketua" id="hiddenJabatanSub" value="Bendahara">

                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Nama Pejabat</label>
                        <input type="text" name="nama_subketua" placeholder="Contoh: Muhammad Fulan" value="<%= lastClosing.nama_subketua || '' %>" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-white">
                    </div>
                </div>
            </div>

            <div class="flex gap-3 pt-4 border-t border-gray-100">
                <button type="button" onclick="tutupModalTutupBuku()" class="flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition-colors">
                    Batal
                </button>
                <button type="submit" class="flex-1 px-4 py-3 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-sm font-bold transition-colors shadow-sm">
                    Kunci & Tutup Buku
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL KONFIRMASI HAPUS -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="deleteModalContainer">
        <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Konfirmasi Hapus</h3>
            <p class="text-sm text-gray-500 mb-6">Apakah Anda yakin ingin menghapus catatan transaksi ini secara permanen?</p>
            <div class="flex space-x-3">
                <button type="button" onclick="closeDeleteModal()" class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition-colors">
                    Batal
                </button>
                <form id="deleteForm" method="POST" class="flex-1">
                    <button type="submit" class="w-full px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                        Ya, Hapus
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    let currentScale = 1;

    function bukaNotaModal(imageUrl) {
        const modal = document.getElementById('notaModal');
        const container = document.getElementById('notaModalContainer');
        const img = document.getElementById('notaImageSource');
        img.src = imageUrl;
        currentScale = 1;
        img.style.transform = `scale(${currentScale})`;
        document.getElementById('zoomLevelText').innerText = '100%';
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function tutupNotaModal() {
        const modal = document.getElementById('notaModal');
        const container = document.getElementById('notaModalContainer');
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
            document.getElementById('notaImageSource').src = '';
        }, 200);
    }

    function zoomNota(amount) {
        currentScale += amount;
        if (currentScale < 0.4) currentScale = 0.4;
        if (currentScale > 3.0) currentScale = 3.0;
        const img = document.getElementById('notaImageSource');
        img.style.transform = `scale(${currentScale})`;
        document.getElementById('zoomLevelText').innerText = Math.round(currentScale * 100) + '%';
    }

    function resetZoom() {
        currentScale = 1;
        const img = document.getElementById('notaImageSource');
        img.style.transform = `scale(${currentScale})`;
        document.getElementById('zoomLevelText').innerText = '100%';
    }

    function bukaModalTutupBuku() {
        const modal = document.getElementById('tutupBukuModal');
        const container = document.getElementById('tutupBukuContainer');
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function tutupModalTutupBuku() {
        const modal = document.getElementById('tutupBukuModal');
        const container = document.getElementById('tutupBukuContainer');
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => { modal.classList.add('hidden'); }, 200);
    }

    function openDeleteModal(actionUrl) {
        const modal = document.getElementById('deleteModal');
        const container = document.getElementById('deleteModalContainer');
        const form = document.getElementById('deleteForm');
        form.action = actionUrl;
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        const container = document.getElementById('deleteModalContainer');
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => { modal.classList.add('hidden'); }, 200);
    }

    function previewLogoBaru(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const previewContainer = document.querySelector('.w-16.h-16');
                // Cek apakah tag img sudah ada di dalam container
                let img = document.getElementById('logoPreviewImg');
                if (!img) {
                    // Jika tadinya belum ada gambar (tertulis "Belum Ada"), buat elemen img baru
                    previewContainer.innerHTML = `<img id="logoPreviewImg" src="" alt="Pratinjau Logo" class="w-full h-full object-contain">`;
                    img = document.getElementById('logoPreviewImg');
                }
                img.src = e.target.result;
            }
            reader.readAsDataURL(file);
        }
    }

    function handleJabatanChange(target) {
        const select = document.getElementById(target === 'Ketua' ? 'selectJabatanKetua' : 'selectJabatanSub');
        const wrapperCustom = document.getElementById(target === 'Ketua' ? 'wrapperCustomJabatanKetua' : 'wrapperCustomJabatanSub');
        const inputCustom = document.getElementById(target === 'Ketua' ? 'inputCustomJabatanKetua' : 'inputCustomJabatanSub');
        const hiddenInput = document.getElementById(target === 'Ketua' ? 'hiddenJabatanKetua' : 'hiddenJabatanSub');

        if (select.value === 'Custom') {
            wrapperCustom.classList.remove('hidden');
            hiddenInput.value = inputCustom.value; 
        } else {
            wrapperCustom.classList.add('hidden');
            hiddenInput.value = select.value; 
        }
    }

    function syncJabatan(target) {
        const inputCustom = document.getElementById(target === 'Ketua' ? 'inputCustomJabatanKetua' : 'inputCustomJabatanSub');
        const hiddenInput = document.getElementById(target === 'Ketua' ? 'hiddenJabatanKetua' : 'hiddenJabatanSub');
        hiddenInput.value = inputCustom.value;
    }
</script>

