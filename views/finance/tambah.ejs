<%- include('../partials/header') %>

<div class="max-w-xl mx-auto p-4 md:p-6 mt-10 font-sans">
    <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-gray-200">
        
        <div class="flex justify-between items-center mb-6 border-b pb-4">
            <div>
                <h1 class="text-xl font-bold text-gray-800 flex items-center gap-2">
                    <span>➕</span> Catat Transaksi Baru
                </h1>
                <p class="text-xs text-gray-500 mt-0.5">Tambah catatan kas masuk atau kas keluar operasional masjid.</p>
            </div>
            <a href="/admin/finance" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors">
                Kembali
            </a>
        </div>

        <!-- KOTAK PERINGATAN JIKA PERIODE TERKUNCI (DIKONTROL JS) -->
        <div id="lockWarningBox" class="hidden mb-4 p-4 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs font-bold flex items-center gap-2">
            <span>🔒</span>
            <span id="lockWarningText">Peringatan: Periode bulan ini sudah ditutup buku. Input transaksi ditolak!</span>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs font-medium">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin/finance/tambah" method="POST" enctype="multipart/form-data" class="space-y-4" id="formTambahTrx">
            
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Tanggal Transaksi <span class="text-rose-500">*</span></label>
                <!-- Tambahkan onchange untuk cek status tutup buku secara real-time -->
                <input type="date" name="tanggal" id="inputTanggal" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white">
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Jenis Transaksi <span class="text-rose-500">*</span></label>
                <select name="jenis" id="jenisTransaksi" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white font-semibold text-emerald-800">
                    <option value="masuk">Kas Masuk (Penerimaan)</option>
                    <option value="keluar">Kas Keluar (Pengeluaran)</option>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Pilih Kategori <span class="text-rose-500">*</span></label>
                <select name="kategori_id" id="kategoriDropdown" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white">
                    <% categories.forEach(cat => { %>
                        <option value="<%= cat.id %>" data-jenis="<%= cat.jenis %>"><%= cat.nama_kategori %> (<%= cat.jenis === 'masuk' ? 'Masuk' : 'Keluar' %>)</option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Jumlah Nominal (Rp) <span class="text-rose-500">*</span></label>
                <input type="text" id="inputJumlah" placeholder="Contoh: 500.000" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none font-bold text-gray-800">
                <input type="hidden" name="jumlah" id="hiddenJumlah">
            </div>

            <!-- UPLOAD BUKTI NOTA -->
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Upload Bukti Terima / Nota (Opsional)</label>
                <input type="file" name="lampiran" accept="image/*" class="w-full border border-gray-300 p-2 rounded-xl text-xs bg-gray-50 cursor-pointer">
                <p class="text-[10px] text-gray-400 mt-1">Format gambar (JPG, PNG). Nama file disesuaikan otomatis oleh sistem.</p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Keterangan / Catatan Tambahan (Opsional)</label>
                <textarea name="keterangan" rows="3" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Contoh: Pembayaran listrik bulanan masjid..."></textarea>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <a href="/admin/finance" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-semibold transition-colors">
                    Batal
                </a>
                <button type="submit" id="btnSubmitTrx" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-semibold transition-colors shadow-sm">
                    Simpan Transaksi
                </button>
            </div>
        </form>

    </div>
</div>

<!-- MODAL NOTIFIKASI SUKSES -->
<div id="successModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="successContainer">
        <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Berhasil Disimpan!</h3>
            <p class="text-sm text-gray-500 mb-6">Data transaksi keuangan berhasil dicatat ke dalam sistem.</p>
            <div class="flex gap-2">
                <button type="button" onclick="window.location.href='/admin/finance/tambah'" class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition-colors">
                    Tambah Lagi
                </button>
                <button type="button" onclick="window.location.href='/admin/finance'" class="flex-1 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                    Lihat Kas
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Set tanggal default ke hari ini
        const inputTanggal = document.getElementById('inputTanggal');
        const today = new Date().toISOString().split('T')[0];
        inputTanggal.value = today;

        // Fungsi AJAX/Fetch kecil untuk mengecek status tutup buku tanggal yang dipilih
        async function cekStatusClosing(tanggalStr) {
            if (!tanggalStr) return;
            const parts = tanggalStr.split('-');
            const tahun = parts[0];
            const bulan = parts[1];

            try {
                const response = await fetch(`/admin/finance/check-closing?bulan=${bulan}&tahun=${tahun}`);
                const data = await response.json();
                
                const warningBox = document.getElementById('lockWarningBox');
                const warningText = document.getElementById('lockWarningText');
                const btnSubmit = document.getElementById('btnSubmitTrx');

                if (data.isClosed) {
                    warningBox.classList.remove('hidden');
                    warningText.innerText = `Periode bulan ${bulan}-${tahun} sudah Tutup Buku (Terkunci). Input transaksi tidak diizinkan!`;
                    btnSubmit.disabled = true;
                    btnSubmit.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    warningBox.classList.add('hidden');
                    btnSubmit.disabled = false;
                    btnSubmit.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            } catch (err) {
                console.error("Gagal mengecek status closing:", err);
            }
        }

        inputTanggal.addEventListener('change', function() {
            cekStatusClosing(this.value);
        });
        cekStatusClosing(inputTanggal.value);

        // Filter Kategori Kas Masuk / Keluar
        const jenisSelect = document.getElementById('jenisTransaksi');
        const kategoriSelect = document.getElementById('kategoriDropdown');
        const options = kategoriSelect.querySelectorAll('option');

        function filterKategori() {
            const selectedJenis = jenisSelect.value;
            let hasVisibleSelected = false;

            options.forEach(opt => {
                const optJenis = opt.getAttribute('data-jenis');
                if (optJenis === selectedJenis) {
                    opt.style.display = 'block';
                    if (opt.selected) hasVisibleSelected = true;
                } else {
                    opt.style.display = 'none';
                }
            });

            if (!hasVisibleSelected) {
                for (let opt of options) {
                    if (opt.getAttribute('data-jenis') === selectedJenis) {
                        opt.selected = true;
                        break;
                    }
                }
            }
        }

        jenisSelect.addEventListener('change', filterKategori);
        filterKategori();

        // Format Rupiah
        const inputJumlah = document.getElementById('inputJumlah');
        const hiddenJumlah = document.getElementById('hiddenJumlah');

        function formatRupiah(angka) {
            let numberString = angka.replace(/[^,\d]/g, '').toString();
            let split = numberString.split(',');
            let sisa = split[0].length % 3;
            let rupiah = split[0].substr(0, sisa);
            let ribuan = split[0].substr(sisa).match(/\d{3}/gi);

            if (ribuan) {
                let separator = sisa ? '.' : '';
                rupiah += separator + ribuan.join('.');
            }
            return split[1] !== undefined ? rupiah + ',' + split[1] : rupiah;
        }

        inputJumlah.addEventListener('keyup', function() {
            let nilaiAsli = this.value.replace(/\./g, '');
            hiddenJumlah.value = nilaiAsli;
            this.value = formatRupiah(this.value);
        });

        // Cek parameter sukses simpan
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('success') === '1') {
            const modal = document.getElementById('successModal');
            const container = document.getElementById('successContainer');
            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }
    });
</script>

<%- include('../partials/footer') %>