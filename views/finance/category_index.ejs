<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto p-4 md:p-6 mt-6 font-sans">
    
    <div class="flex justify-between items-center mb-6 bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
        <div>
            <h1 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
                <span>🏷️</span> Kelola Kategori Keuangan
            </h1>
            <p class="text-xs text-gray-500 mt-1">Buat daftar kategori baku untuk memudahkan pencatatan kas masuk dan kas keluar.</p>
        </div>
        <a href="/admin/finance" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-semibold transition">
            Kembali ke Kas
        </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- FORM DINAMIS (TAMBAH / EDIT KATEGORI) -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200 h-fit">
            <h3 class="font-bold text-gray-800 text-sm mb-4 pb-2 border-b">
                <%= typeof categoryToEdit !== 'undefined' && categoryToEdit ? 'Edit Kategori' : 'Tambah Kategori Baru' %>
            </h3>
            
            <form action="<%= typeof categoryToEdit !== 'undefined' && categoryToEdit ? '/admin/finance/categories/edit/' + categoryToEdit.id : '/admin/finance/categories/tambah' %>" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Kategori <span class="text-rose-500">*</span></label>
                    <input type="text" name="nama_kategori" value="<%= typeof categoryToEdit !== 'undefined' && categoryToEdit ? categoryToEdit.nama_kategori : '' %>" placeholder="Contoh: Pembayaran Listrik" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Jenis Transaksi <span class="text-rose-500">*</span></label>
                    <select name="jenis" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white font-semibold text-emerald-800">
                        <option value="masuk" <%= typeof categoryToEdit !== 'undefined' && categoryToEdit && categoryToEdit.jenis === 'masuk' ? 'selected' : '' %>>Penerimaan (Kas Masuk)</option>
                        <option value="keluar" <%= typeof categoryToEdit !== 'undefined' && categoryToEdit && categoryToEdit.jenis === 'keluar' ? 'selected' : '' %>>Pengeluaran (Kas Keluar)</option>
                    </select>
                </div>
                
                <div class="flex gap-2 pt-2">
                    <% if (typeof categoryToEdit !== 'undefined' && categoryToEdit) { %>
                        <a href="/admin/finance/categories" class="w-1/2 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-bold text-center transition">
                            Batal
                        </a>
                        <button type="submit" class="w-1/2 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm">
                            Perbarui
                        </button>
                    <% } else { %>
                        <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm">
                            Simpan Kategori
                        </button>
                    <% } %>
                </div>
            </form>
        </div>

        <!-- TABEL DAFTAR KATEGORI -->
        <div class="md:col-span-2 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
            <div class="p-5 border-b border-gray-100">
                <h3 class="font-bold text-gray-800 text-sm">Daftar Kategori Tersedia</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="bg-gray-50/70 text-gray-500 uppercase text-[10px] tracking-wider border-b border-gray-200">
                            <th class="p-4 font-bold">No</th>
                            <th class="p-4 font-bold">Nama Kategori</th>
                            <th class="p-4 font-bold">Jenis</th>
                            <th class="p-4 font-bold text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-gray-700">
                        <% if (categories.length === 0) { %>
                            <tr>
                                <td colspan="4" class="p-8 text-center text-gray-400 italic text-xs">Belum ada kategori yang dibuat.</td>
                            </tr>
                        <% } else { %>
                            <% categories.forEach((cat, index) => { %>
                                <tr class="hover:bg-gray-50/50 transition-colors">
                                    <td class="p-4 text-gray-500 text-xs"><%= index + 1 %></td>
                                    <td class="p-4 font-semibold text-gray-800"><%= cat.nama_kategori %></td>
                                    <td class="p-4">
                                        <% if (cat.jenis === 'masuk') { %>
                                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800">Kas Masuk</span>
                                        <% } else { %>
                                            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-100 text-rose-800">Kas Keluar</span>
                                        <% } %>
                                    </td>
                                    <td class="p-4 text-center whitespace-nowrap flex items-center justify-center gap-1.5">
                                        <!-- Tombol Edit Langsung di Form Kiri -->
                                        <a href="/admin/finance/categories?edit=<%= cat.id %>" title="Edit Kategori" class="p-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-600 rounded-lg transition">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                        </a>
                                        <!-- Tombol Hapus dengan Modal Kustom -->
                                        <button type="button" onclick="openDeleteModal('/admin/finance/categories/hapus/<%= cat.id %>')" title="Hapus Kategori" class="p-2 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- MODAL POPUP KONFIRMASI HAPUS KUSTOM -->
<div id="deleteModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="deleteModalContainer">
        <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Konfirmasi Hapus</h3>
            <p class="text-sm text-gray-500 mb-6">Apakah Anda yakin ingin menghapus kategori ini secara permanen?</p>
                
            <div class="flex space-x-3">
                <button type="button" onclick="closeDeleteModal()" class="flex-1 px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-sm font-semibold transition-colors">
                    Batal
                </button>
                <form id="deleteForm" method="POST" class="flex-1">
                    <button type="submit" class="w-full px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                        Ya, Hapus
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openDeleteModal(actionUrl) {
        const modal = document.getElementById('deleteModal');
        const container = document.getElementById('deleteModalContainer');
        const form = document.getElementById('deleteForm');
        
        form.action = actionUrl;
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeDeleteModal() {
        const modal = document.getElementById('deleteModal');
        const container = document.getElementById('deleteModalContainer');
        
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }
</script>

<%- include('../partials/footer') %>