<%- include('../partials/header') %>

<div class="max-w-5xl mx-auto p-4 md:p-6 mt-6 font-sans space-y-6">
    
    <!-- HEADER KARTU UTAMA -->
    <div class="bg-white p-6 md:p-8 rounded-3xl shadow-sm border border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Daftar Arsip Laporan Keuangan</h1>
        </div>
        <a href="/admin/finance" class="px-4 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-semibold transition-colors">
            ← Kembali ke Kas Utama
        </a>
    </div>

    <!-- DAFTAR KARTU PERIODE TUTUP Buku -->
    <% if (closings.length === 0) { %>
        <div class="bg-white p-12 rounded-3xl shadow-sm border border-gray-200 text-center space-y-3">
            <div class="w-16 h-16 bg-amber-50 text-amber-600 rounded-full flex items-center justify-center mx-auto text-2xl font-bold">📂</div>
            <h3 class="text-base font-bold text-gray-800">Belum Ada Periode yang Ditutup</h3>
            <p class="text-xs text-gray-500 max-w-md mx-auto">Lakukan proses **Tutup Buku Bulan Ini** terlebih dahulu dari halaman utama Kas Masjid untuk menerbitkan arsip laporan resmi.</p>
            <div class="pt-2">
                <a href="/admin/finance" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm inline-block">
                    Ke Halaman Kas Masjid
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="space-y-4">
            <% closings.forEach(c => { %>
                <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:border-emerald-300 transition-all">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <h3 class="text-lg font-bold text-gray-800">
                                Laporan Keuangan Periode <%= c.nama_bulan_teks %> <%= c.tahun %>
                            </h3>
                            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-[10px] font-extrabold uppercase">
                                Selesai
                            </span>
                        </div>
                        <p class="text-xs text-gray-500">
                            Sisa Saldo Akhir: <strong class="text-gray-800">Rp <%= Number(c.saldo_akhir).toLocaleString('id-ID') %></strong>
                        </p>
                    </div>

                    <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                        <a href="/admin/finance/laporan/edit/<%= c.id %>" class="px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            Edit
                        </a>
                        <!-- Tombol Cetak Laporan (Langsung lempar parameter bulan & tahun) -->
                        <a href="/admin/finance/cetak?bulan=<%= c.bulan %>&tahun=<%= c.tahun %>" class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-1.5">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                            Cetak Laporan
                        </a>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

</div>

<%- include('../partials/footer') %>