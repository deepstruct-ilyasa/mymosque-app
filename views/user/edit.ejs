<%- include('../partials/header') %>

<div class="max-w-xl mx-auto space-y-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <h2 class="text-2xl font-bold text-gray-800">Edit Pengguna</h2>
        <p class="text-gray-500 text-sm">Perbarui informasi akun atau ubah kata sandi.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form action="/admin/users/edit/<%= user.id %>" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Nama Lengkap</label>
                <input type="text" name="nama_lengkap" value="<%= user.nama_lengkap %>" required class="w-full border border-gray-300 rounded-xl p-3.5 text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Username</label>
                <input type="text" name="username" value="<%= user.username %>" required class="w-full border border-gray-300 rounded-xl p-3.5 text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Password Baru <span class="text-xs text-gray-400 font-normal">(Kosongkan jika tidak ingin mengubah password)</span></label>
                <input type="password" name="password" placeholder="Biarkan kosong jika tetap" class="w-full border border-gray-300 rounded-xl p-3.5 text-sm focus:ring-2 focus:ring-emerald-500 outline-none">
            </div>

            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Hak Akses (Role)</label>
                <select name="role" class="w-full border border-gray-300 rounded-xl p-3.5 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white font-semibold text-emerald-800">
                    <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin</option>
                    <option value="Super Admin" <%= user.role === 'Super Admin' ? 'selected' : '' %>>Super Admin</option>
                    <option value="Petugas" <%= user.role === 'Petugas' ? 'selected' : '' %>>Petugas Input</option>
                </select>
            </div>

            <div class="space-y-2 border border-gray-200 p-4 rounded-xl bg-gray-50">
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Hak Akses Modul:</label>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <% allModules.forEach(mod => { %>
                        <% 
                            // Cek apakah modul ini ada di dalam array permissions milik user yang diedit
                            const hasPermission = user.permissions && user.permissions.includes(mod.key);
                        %>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" name="permissions" value="<%= mod.key %>" 
                                <%= hasPermission ? 'checked' : '' %> 
                                class="rounded text-emerald-600 focus:ring-emerald-500">
                            <span><%= mod.label %></span>
                        </label>
                    <% }) %>
                </div>
            </div>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-between items-center">
                <a href="/admin/users" class="text-sm font-semibold text-gray-500 hover:text-gray-700">← Batal</a>
                <button type="submit" class="py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition">
                    Perbarui Pengguna
                </button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL POPUP NOTIFIKASI -->
<div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
        <div class="text-center">
            <div id="notifIconSuccess" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div id="notifIconError" class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <h3 id="notifTitle" class="text-lg font-bold text-gray-800 mb-1">Notifikasi</h3>
            <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan...</p>
            <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>

<script>
    function showNotification(isSuccess, message) {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        const iconSuccess = document.getElementById('notifIconSuccess');
        const iconError = document.getElementById('notifIconError');
        const title = document.getElementById('notifTitle');
        const msg = document.getElementById('notifMessage');

        msg.innerText = message;
        if (isSuccess) {
            title.innerText = "Berhasil!";
            iconSuccess.classList.remove('hidden');
            iconError.classList.add('hidden');
        } else {
            title.innerText = "Gagal!";
            iconError.classList.remove('hidden');
            iconSuccess.classList.add('hidden');
        }

        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeNotificationModal() {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => { 
            modal.classList.add('hidden'); 
            
            // TAMBAHAN INI: Begitu tombol OK diklik setelah sukses, arahkan kembali ke halaman index user 
            // agar sesi/cookie di sidebar ikut melakukan reload total secara otomatis!
            <% if (typeof success !== 'undefined' && success) { %>
                window.location.href = '/admin/users'; 
            <% } %>
        }, 200);
    }

    <% if (typeof error !== 'undefined' && error) { %>
        showNotification(false, '<%= error %>');
    <% } %>
</script>

<%- include('../partials/footer') %>