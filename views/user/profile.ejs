<%- include('../partials/header') %>

    <div class="max-w-xl mx-auto p-6 mt-10">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
            
            <!-- Header -->
            <div class="flex justify-between items-center mb-6 border-b pb-4">
                <div>
                    <h1 class="text-xl font-bold text-gray-800">👤 Edit Profil Saya</h1>
                    <p class="text-xs text-gray-500">Perbarui informasi akun dan kata sandi Anda di sini.</p>
                </div>
                <a href="/admin/dashboard" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors">
                    Kembali
                </a>
            </div>

            <!-- Form Edit -->
            <form action="/admin/users/profile" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                    <input type="text" name="username" value="<%= userProfile.username %>" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Lengkap</label>
                    <input type="text" name="nama_lengkap" value="<%= userProfile.nama_lengkap || '' %>" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password Baru <span class="text-gray-400 font-normal">(Kosongkan jika tidak ingin mengubah password)</span></label>
                    <input type="password" name="password_baru" placeholder="••••••••" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div class="pt-4 flex justify-end space-x-3">
                    <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                        Simpan Perubahan
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL POPUP NOTIFIKASI (SUKSES / GAGAL) -->
    <!-- ========================================== -->
    <div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
            <div class="text-center">
                <!-- Ikon Status Dinamis -->
                <div id="notifIconSuccess" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 hidden">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div id="notifIconError" class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4 hidden">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>

                <h3 id="notifTitle" class="text-lg font-bold text-gray-800 mb-1">Notifikasi</h3>
                <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan notifikasi di sini...</p>
                
                <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                    OK, Mengerti
                </button>
            </div>
        </div>
    </div>

    <!-- Skrip Pengontrol Modal Popup -->
    <script>
        function showNotification(isSuccess, message) {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            const iconSuccess = document.getElementById('notifIconSuccess');
            const iconError = document.getElementById('notifIconError');
            const title = document.getElementById('notifTitle');
            const msg = document.getElementById('notifMessage');

            msg.innerText = message;

            if (isSuccess) {
                title.innerText = "Berhasil!";
                iconSuccess.classList.remove('hidden');
                iconError.classList.add('hidden');
            } else {
                title.innerText = "Gagal!";
                iconError.classList.remove('hidden');
                iconSuccess.classList.add('hidden');
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeNotificationModal() {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // Trigger otomatis dari variabel controller backend
        <% if (typeof success !== 'undefined' && success) { %>
            showNotification(true, 'Profil Anda berhasil diperbarui secara permanen!');
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
            showNotification(false, '<%= error %>');
        <% } %>
    </script>

<%- include('../partials/footer') %>