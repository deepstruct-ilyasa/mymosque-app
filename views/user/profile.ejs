<%- include('../partials/header') %>

    <div class="max-w-xl mx-auto p-6 mt-10 font-sans">
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
            
            <!-- Header -->
            <div class="flex justify-between items-center mb-6 border-b pb-4">
                <div>
                    <h1 class="text-xl font-bold text-gray-800">👤 Edit Profil</h1>
                    <p class="text-xs text-gray-500">Perbarui informasi akun, kata sandi, dan foto profil Anda di sini.</p>
                </div>
                <a href="/admin/dashboard" class="px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg text-xs font-semibold transition-colors">
                    Kembali
                </a>
            </div>

            <!-- Form Edit dengan ID untuk AJAX -->
            <form id="profileForm" enctype="multipart/form-data" class="space-y-4">
                
                <!-- BAGIAN PREVIEW & UPLOAD FOTO PROFIL -->
                <div class="flex items-center gap-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
                    <div id="avatarPreviewContainer" class="w-16 h-16 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-xl shadow overflow-hidden flex-shrink-0 border-1 border-emerald-500">
                        <% if (userProfile.foto) { %>
                            <img id="avatarImg" src="/uploads/users/<%= userProfile.foto %>" alt="Foto Profil" class="w-full h-full object-cover">
                        <% } else { %>
                            <span id="avatarInitial"><%= userProfile.nama_lengkap ? userProfile.nama_lengkap.charAt(0).toUpperCase() : 'U' %></span>
                        <% } %>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-gray-600 mb-1">Ganti Foto Profil</label>
                        <input type="file" id="fotoInput" name="foto" accept="image/*" class="w-full text-xs text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 cursor-pointer">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Username</label>
                    <input type="text" id="usernameInput" name="username" value="<%= userProfile.username %>" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Nama Lengkap</label>
                    <input type="text" id="namaLengkapInput" name="nama_lengkap" value="<%= userProfile.nama_lengkap || '' %>" required class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password Lama <span class="text-rose-500">*</span></label>
                    <input type="password" name="password_lama" placeholder="Wajib diisi jika ingin mengubah password" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    <p class="text-[10px] text-gray-400 mt-0.5">Diperlukan sandi saat ini untuk keamanan jika Anda ingin mengganti password.</p>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-600 mb-1">Password Baru <span class="text-gray-400 font-normal">(Kosongkan jika tidak ingin mengubah password)</span></label>
                    <input type="password" id="passwordBaruInput" name="password_baru" placeholder="••••••••" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div class="pt-4 flex justify-end space-x-3">
                    <button type="submit" id="submitBtn" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                        Simpan Perubahan
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL POPUP NOTIFIKASI -->
    <!-- ========================================== -->
    <div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
            <div class="text-center">
                <div id="notifIconSuccess" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 hidden">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <div id="notifIconError" class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4 hidden">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </div>

                <h3 id="notifTitle" class="text-lg font-bold text-gray-800 mb-1">Notifikasi</h3>
                <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan notifikasi di sini...</p>
                
                <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                    OK, Mengerti
                </button>
            </div>
        </div>
    </div>

    <!-- SKRIP AJAX / FETCH API -->
    <script>
        function showNotification(isSuccess, message) {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            const iconSuccess = document.getElementById('notifIconSuccess');
            const iconError = document.getElementById('notifIconError');
            const title = document.getElementById('notifTitle');
            const msg = document.getElementById('notifMessage');

            msg.innerText = message;

            if (isSuccess) {
                title.innerText = "Berhasil!";
                iconSuccess.classList.remove('hidden');
                iconError.classList.add('hidden');
            } else {
                title.innerText = "Gagal!";
                iconError.classList.remove('hidden');
                iconSuccess.classList.add('hidden');
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                container.classList.remove('scale-95', 'opacity-0');
                container.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeNotificationModal() {
            const modal = document.getElementById('notificationModal');
            const container = document.getElementById('notifModalContainer');
            
            container.classList.remove('scale-100', 'opacity-100');
            container.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        // ==========================================================
        // 1. LIVE PREVIEW: Begitu file dipilih, langsung tampilkan gambarnya
        // ==========================================================
        document.getElementById('fotoInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const container = document.getElementById('avatarPreviewContainer');
                    // Ganti isi kontainer dengan gambar baru yang dipilih (belum masuk database)
                    container.innerHTML = `<img src="${event.target.result}" alt="Pratinjau Foto" class="w-full h-full object-cover">`;
                }
                reader.readAsDataURL(file);
            }
        });

        // ==========================================================
        // 2. SUBMIT AJAX: Data baru disimpan ke server saat tombol diklik
        // ==========================================================
        document.getElementById('profileForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.innerText = 'Menyimpan...';

            try {
                const response = await fetch('/admin/users/profile', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                const result = await response.json();

if (response.ok && result.success) {
                    showNotification(true, 'Profil berhasil diperbarui secara instan!');
                    
                    // 1. Ambil nilai input terbaru yang baru saja disimpan
                    const namaBaru = document.getElementById('namaLengkapInput').value.trim();
                    const usernameBaru = document.getElementById('usernameInput').value.trim();

                    // 2. Perbarui tampilan Nama Lengkap / Username di Sidebar secara Live
                    const sidebarNamaEl = document.querySelector('aside .flex.items-center.space-x-3 p-1, aside .overflow-hidden p.text-sm.font-semibold');
                    if (sidebarNamaEl) {
                        sidebarNamaEl.innerText = namaBaru;
                    }

                    // Alternatif selector universal untuk teks nama di sidebar (jika struktur class berbeda)
                    const sidebarUserParagraphs = document.querySelectorAll('aside p.text-sm.font-semibold.text-white');
                    sidebarUserParagraphs.forEach(p => {
                        p.innerText = namaBaru;
                    });

                    // 3. Perbarui foto di sidebar secara live jika ada perubahan foto
                    if (result.fotoBaru) {
                        const sidebarImgContainer = document.querySelector('aside .w-10.h-10');
                        if (sidebarImgContainer) {
                            sidebarImgContainer.innerHTML = `<img src="/uploads/users/${result.fotoBaru}" alt="Foto Profil" class="w-full h-full object-cover">`;
                        }
                    } else {
                        // Jika foto dihapus atau kembali ke inisial huruf berdasarkan nama baru
                        const sidebarImgContainer = document.querySelector('aside .w-10.h-10');
                        if (sidebarImgContainer && namaBaru) {
                            // Cek apakah isinya gambar, jika ingin di-update inisialnya juga bisa diatur di sini
                        }
                    }

                    // 4. Kosongkan input password lama & baru setelah sukses tersimpan
                    const passLamaInput = document.querySelector('input[name="password_lama"]');
                    if (passLamaInput) passLamaInput.value = '';
                    document.getElementById('passwordBaruInput').value = '';
                } else {
                    showNotification(false, result.error || 'Gagal memperbarui profil.');
                }
            } catch (err) {
                console.error(err);
                showNotification(false, 'Terjadi kesalahan pada jaringan atau server.');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = 'Simpan Perubahan';
            }
        });
    </script>

<%- include('../partials/footer') %>