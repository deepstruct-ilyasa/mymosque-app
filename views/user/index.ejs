<%- include('../partials/header') %>

<div class="max-w-6xl mx-auto space-y-6 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Manajemen Sistem</span>
            <h2 class="text-2xl font-bold text-gray-800 mt-2">Daftar Pengguna Aplikasi</h2>
            <p class="text-gray-500 text-sm">Kelola akun admin dan petugas yang memiliki akses ke sistem MyMosque.</p>
        </div>
        <a href="/admin/users/tambah" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition">
            + Tambah Pengguna
        </a>
    </div>

    <!-- Tabel Daftar Pengguna -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto w-full">
            <table class="w-full text-left border-collapse min-w-[600px]">
                <thead>
                    <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                        <th class="p-4">No</th>
                        <th class="p-4">Nama Lengkap</th>
                        <th class="p-4">Username</th>
                        <th class="p-4">Role / Hak Akses</th>
                        <th class="p-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    <% if (!users || users.length === 0) { %>
                        <tr>
                            <td colspan="5" class="p-6 text-center text-gray-400 italic">Belum ada pengguna terdaftar.</td>
                        </tr>
                    <% } else { %>
                        <% users.forEach((u, index) => { %>
                            <tr class="hover:bg-gray-50/50 transition-colors">
                                <td class="p-4 text-gray-500"><%= index + 1 %></td>
                                <td class="p-4 font-semibold text-gray-800"><%= u.nama_lengkap || '-' %></td>
                                <td class="p-4 text-gray-600"><%= u.username %></td>
                                <td class="p-4">
                                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold <%= u.role === 'Super Admin' ? 'bg-purple-100 text-purple-800' : 'bg-emerald-100 text-emerald-800' %>">
                                        <%= u.role || 'undefined' %>
                                    </span>
                                </td>
                                <td class="p-4 text-center whitespace-nowrap">
                                    <div class="inline-flex items-center space-x-1.5">
                                        
                                        <!-- TOMBOL EDIT (Ikon Pensil) -->
                                        <a href="/admin/users/edit/<%= u.id %>" title="Edit Pengguna" class="p-2 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg transition">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                            </svg>
                                        </a>
                                        
                                        <!-- TOMBOL RESET PASSWORD (Ikon Kunci / Ganti Sandi - Hanya muncul jika bukan akun sendiri) -->
                                        <% if (currentUser && currentUser.id !== u.id) { %>
                                            <button type="button" onclick="openResetModal('<%= u.id %>', '<%= u.username %>')" title="Reset Password" class="p-2 bg-blue-50 hover:bg-blue-100 text-blue-700 rounded-lg transition">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                                                </svg>
                                            </button>
                                        <% } %>

                                        <!-- TOMBOL HAPUS (Ikon Tempat Sampah) -->
                                        <form action="/admin/users/hapus/<%= u.id %>" method="POST" class="inline" onsubmit="return confirm('Yakin ingin menghapus pengguna ini?')">
                                            <button type="submit" title="Hapus Pengguna" class="p-2 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                                </svg>
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL POPUP FORM RESET PASSWORD ADMIN -->
<!-- ========================================== -->
<div id="resetModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="resetModalContainer">
        <h3 class="text-lg font-bold text-gray-800 mb-1">Reset Password Pengguna</h3>
        <p class="text-xs text-gray-500 mb-4">Masukkan password baru untuk akun <span id="targetUsername" class="font-bold text-gray-700"></span>.</p>
        
        <form id="resetForm" method="POST" class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-gray-600 mb-1">Password Baru</label>
                <input type="password" name="password_baru" required placeholder="Minimal 6 karakter" class="w-full border border-gray-300 p-2.5 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
            </div>

            <div class="flex space-x-2 pt-2">
                <button type="button" onclick="closeResetModal()" class="flex-1 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-xl text-xs font-semibold transition">
                    Batal
                </button>
                <button type="submit" class="flex-1 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-xs font-semibold transition shadow-sm">
                    Simpan Sandi Baru
                </button>
            </div>
        </form>
    </div>
</div>

<!-- SKRIP MODAL RESET PASSWORD -->
<script>
    function openResetModal(userId, username) {
        const modal = document.getElementById('resetModal');
        const container = document.getElementById('resetModalContainer');
        const form = document.getElementById('resetForm');
        const spanUser = document.getElementById('targetUsername');

        spanUser.innerText = username;
        form.action = `/admin/users/reset-password/${userId}`;

        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeResetModal() {
        const modal = document.getElementById('resetModal');
        const container = document.getElementById('resetModalContainer');
        
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }
</script>

<%- include('../partials/footer') %>