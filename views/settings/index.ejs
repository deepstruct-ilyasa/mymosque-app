<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto space-y-6 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
        <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase">Preferensi Sistem</span>
        <h2 class="text-2xl font-bold text-gray-800 mt-2">Identitas Masjid</h2>
        <p class="text-gray-500 text-sm">Sesuaikan informasi masjid yang akan tampil pada sidebar aplikasi.</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8">
        <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="space-y-4">
            
            <!-- Input Nama Masjid -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Nama Masjid</label>
                <input type="text" name="mosque_name" value="<%= settings.mosque_name || '' %>" required class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Contoh: Masjid Al-Muharrar">
            </div>

            <!-- Input Alamat Masjid -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Alamat Lengkap Masjid</label>
                <textarea name="mosque_address" rows="2" required class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Contoh: Dukuh XII Sumbersari Moyudan Sleman DI Yogyakarta, 55563"><%= settings.mosque_address || '' %></textarea>
            </div>

            <!-- Layout Grid: 1 Kolom di HP (Mobile), 2 Kolom Sejajar di Desktop (md) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                
                <!-- Input Kontak / No Telepon -->
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">No. Telepon / Kontak Masjid</label>
                    <input type="text" name="mosque_phone" value="<%= settings.mosque_phone || '' %>" class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none" placeholder="Contoh: 081234567890 / (0274) 123456">
                </div>

                <!-- Input Logo Masjid -->
                <div>
                    <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Logo Aplikasi / Masjid</label>
                    
                    <!-- Preview Logo Lama Jika Ada -->
                    <div class="flex items-center gap-3 mb-2">
                        <% if(typeof appSettings !== 'undefined' && appSettings.logo) { %>
                            <div class="w-16 h-16 border border-gray-200 rounded-lg bg-gray-50 flex items-center justify-center overflow-hidden flex-shrink-0">
                                <img src="/uploads/<%= appSettings.logo %>" alt="Logo Utama" class="w-full h-full object-contain">
                            </div>
                            <span class="text-[11px] text-gray-500">Logo utama saat ini.</span>
                            <!-- Input hidden untuk menyimpan nama file lama jika tidak diganti -->
                            <input type="hidden" name="old_logo" value="<%= appSettings.logo %>">
                        <% } %>
                    </div>

                    <input type="file" name="logo" accept="image/*" class="w-full border border-gray-300 rounded-lg p-2 text-xs bg-gray-50">
                    <p class="text-[10px] text-gray-400 mt-1">Biarkan kosong jika tidak ingin mengubah logo.</p>
                </div>

            </div>

            <!-- Input Zona Waktu -->
            <div>
                <label class="block text-xs font-bold uppercase tracking-wider text-gray-600 mb-1">Zona Waktu Masjid</label>
                <select name="timezone" required class="w-full border border-gray-300 rounded-lg p-3 text-sm focus:ring-2 focus:ring-emerald-500 outline-none bg-white">
                    <option value="Asia/Jakarta" <%= settings.timezone === 'Asia/Jakarta' ? 'selected' : '' %>>WIB (Waktu Indonesia Barat - Asia/Jakarta)</option>
                    <option value="Asia/Makassar" <%= settings.timezone === 'Asia/Makassar' ? 'selected' : '' %>>WITA (Waktu Indonesia Tengah - Asia/Makassar)</option>
                    <option value="Asia/Jayapura" <%= settings.timezone === 'Asia/Jayapura' ? 'selected' : '' %>>WIT (Waktu Indonesia Timur - Asia/Jayapura)</option>
                </select>
            </div>
            
            <div class="pt-4 border-t border-gray-100 flex justify-end">
                <button type="submit" class="py-3 px-6 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition">
                    Simpan
                </button>
            </div>

        </form>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL POPUP NOTIFIKASI (SUKSES / GAGAL) -->
<!-- ========================================== -->
<div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
        <div class="text-center">
            <!-- Ikon Status Dinamis -->
            <div id="notifIconSuccess" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div id="notifIconError" class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>

            <h3 id="notifTitle" class="text-lg font-bold text-gray-800 mb-1">Notifikasi</h3>
            <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan notifikasi di sini...</p>
            
            <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>

<!-- Skrip Pengontrol Modal Popup -->
<script>
    function showNotification(isSuccess, message) {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        const iconSuccess = document.getElementById('notifIconSuccess');
        const iconError = document.getElementById('notifIconError');
        const title = document.getElementById('notifTitle');
        const msg = document.getElementById('notifMessage');

        msg.innerText = message;

        if (isSuccess) {
            title.innerText = "Berhasil!";
            iconSuccess.classList.remove('hidden');
            iconError.classList.add('hidden');
        } else {
            title.innerText = "Gagal!";
            iconError.classList.remove('hidden');
            iconSuccess.classList.add('hidden');
        }

        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeNotificationModal() {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    // Trigger otomatis dari variabel controller backend jika ada status sukses/error
    <% if (typeof success !== 'undefined' && success) { %>
        showNotification(true, 'Pengaturan identitas masjid berhasil diperbarui!');
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        showNotification(false, '<%= error %>');
    <% } %>
</script>

<%- include('../partials/footer') %>