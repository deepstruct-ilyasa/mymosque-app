<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto mb-12">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 w-full mt-4">
        <div class="w-16 h-16 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 text-center mb-1">Edit Agenda & Ketetapan Zakat</h2>
        <p class="text-gray-500 text-sm text-center mb-6">Perbarui informasi kop surat, pejabat penandatangan, maupun ketentuan standar besaran untuk agenda ini.</p>
        
        <form action="/admin/zakat/laporan/edit/<%= event.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">
            
            <!-- INFORMASI UTAMA -->
            <div class="space-y-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Periode / Agenda</label>
                    <input type="text" id="nama_event" name="nama_event" value="<%= event.nama_event %>" required class="w-full border border-gray-300 rounded-lg p-3 bg-white outline-none focus:ring-2 focus:ring-amber-500">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Keterangan / Deskripsi</label>
                    <input type="text" name="deskripsi" value="<%= event.deskripsi || '' %>" class="w-full border border-gray-300 rounded-lg p-3 bg-white outline-none focus:ring-2 focus:ring-amber-500">
                </div>
            </div>

            <!-- COLLAPSE 1: KOP SURAT -->
            <details class="bg-gray-50 border border-gray-200 rounded-xl p-4 group" open>
                <summary class="font-semibold text-sm text-gray-700 cursor-pointer flex justify-between items-center select-none">
                    <span class="flex items-center gap-2">📂 Identitas Lembaga & Kop Surat</span>
                    <span class="text-xs text-amber-600 font-bold group-open:hidden">[ Buka ]</span>
                    <span class="text-xs text-red-600 font-bold hidden group-open:inline">[ Tutup ]</span>
                </summary>
                
                <div class="mt-4 pt-4 border-t border-gray-200 space-y-3 bg-white p-3 rounded-lg">
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Lembaga / Masjid</label>
                        <input type="text" name="nama_lembaga" value="<%= event.nama_lembaga %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Sub Lembaga / Kepanitiaan</label>
                        <input type="text" name="sub_lembaga" value="<%= event.sub_lembaga %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm">
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">No. Telepon</label>
                            <input type="text" name="telepon" value="<%= event.telepon %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Ganti Logo (Opsional)</label>
                            
                            <!-- PREVIEW LOGO LAMA -->
                            <div class="flex items-center gap-3 mb-2">
                                <% if(event.logo) { %>
                                    <div class="w-12 h-12 border border-gray-200 rounded-lg bg-gray-50 flex items-center justify-center overflow-hidden flex-shrink-0">
                                        <img src="/uploads/zakat/<%= event.logo %>" alt="Logo" class="w-full h-full object-contain">
                                    </div>
                                    <span class="text-[11px] text-gray-500">Logo aktif saat ini. Pilih file baru di bawah jika ingin menggantinya.</span>
                                <% } else { %>
                                    <div class="text-[11px] text-gray-400 italic">Belum ada logo yang di-upload.</div>
                                <% } %>
                            </div>

                            <input type="file" name="logo" class="w-full border border-gray-300 rounded-lg p-2 text-xs bg-gray-50">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Alamat Sekretariat</label>
                        <textarea name="alamat" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" rows="2"><%= event.alamat %></textarea>
                    </div>
                </div>
            </details>

            <!-- COLLAPSE 2: PEJABAT PENANDATANGAN -->
            <details class="bg-gray-50 border border-gray-200 rounded-xl p-4 group">
                <summary class="font-semibold text-sm text-gray-700 cursor-pointer flex justify-between items-center select-none">
                    <span class="flex items-center gap-2">✍️ Pejabat Penandatangan Laporan</span>
                    <span class="text-xs text-amber-600 font-bold group-open:hidden">[ Buka ]</span>
                    <span class="text-xs text-red-600 font-bold hidden group-open:inline">[ Tutup ]</span>
                </summary>
                
                <div class="mt-4 pt-4 border-t border-gray-200 space-y-3 bg-white p-3 rounded-lg">
                    <!-- JABATAN & NAMA KETUA -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Jabatan Utama (Penandatangan 1)</label>
                            <% 
                                const isKetuaStandard = ['Ketua Panitia', 'Ketua Takmir'].includes(event.ketua);
                            %>
                            <select id="select_jabatan_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm bg-white" onchange="toggleCustom('ketua')">
                                <option value="Ketua Panitia" <%= event.ketua === 'Ketua Panitia' ? 'selected' : '' %>>Ketua Panitia</option>
                                <option value="Ketua Takmir" <%= event.ketua === 'Ketua Takmir' ? 'selected' : '' %>>Ketua Takmir</option>
                                <option value="Custom" <%= !isKetuaStandard ? 'selected' : '' %>>Lainnya (Custom)...</option>
                            </select>
                            <input type="text" id="input_jabatan_ketua" name="ketua" value="<%= event.ketua || 'Ketua Panitia' %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm mt-2 <%= isKetuaStandard ? 'hidden' : '' %>" placeholder="Ketik nama jabatan...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Lengkap Ketua</label>
                            <input type="text" id="nama_ketua" name="nama_ketua" value="<%= event.nama_ketua || '' %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: Ust. Ahmad">
                        </div>
                    </div>

                    <!-- JABATAN & NAMA PENDAMPING -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Jabatan Pendamping (Penandatangan 2)</label>
                            <% 
                                const isSubStandard = ['Bendahara', 'Sekretaris'].includes(event.sub_ketua);
                            %>
                            <select id="select_sub_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm bg-white" onchange="toggleCustom('pendamping')">
                                <option value="Bendahara" <%= event.sub_ketua === 'Bendahara' ? 'selected' : '' %>>Bendahara</option>
                                <option value="Sekretaris" <%= event.sub_ketua === 'Sekretaris' ? 'selected' : '' %>>Sekretaris</option>
                                <option value="Custom" <%= !isSubStandard ? 'selected' : '' %>>Lainnya (Custom)...</option>
                            </select>
                            <input type="text" id="input_sub_ketua" name="sub_ketua" value="<%= event.sub_ketua || 'Bendahara' %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm mt-2 <%= isSubStandard ? 'hidden' : '' %>" placeholder="Ketik nama jabatan...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Lengkap Pendamping</label>
                            <input type="text" id="nama_sub_ketua" name="nama_sub_ketua" value="<%= event.nama_sub_ketua || '' %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: Bpk. Budi S.Pd">
                        </div>
                    </div>
                </div>
            </details>

            <!-- KETETAPAN STANDAR ZAKAT FITRAH -->
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ketentuan Standar Zakat Fitrah</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-emerald-50 p-4 rounded-xl border border-emerald-100">
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 mb-1">Beras (Kg per Jiwa)</label>
                        <input type="number" step="0.001" name="standar_fitrah_beras" value="<%= event.standar_fitrah_beras %>" required class="w-full border border-emerald-300 rounded-lg p-2.5 bg-white font-bold text-emerald-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 mb-1">Uang (Rp per Jiwa)</label>
                        <input type="number" name="standar_fitrah_uang" value="<%= event.standar_fitrah_uang %>" required class="w-full border border-emerald-300 rounded-lg p-2.5 bg-white font-bold text-emerald-800">
                    </div>
                </div>
            </div>

            <!-- KETETAPAN STANDAR FIDYAH -->
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ketentuan Standar Fidyah</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-purple-50 p-4 rounded-xl border border-purple-100">
                    <div>
                        <label class="block text-xs font-bold text-purple-900 mb-1">Beras (Kg per Hari)</label>
                        <input type="number" step="0.1" name="standar_fidyah_beras" value="<%= event.standar_fidyah_beras %>" required class="w-full border border-purple-300 rounded-lg p-2.5 bg-white font-bold text-purple-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-purple-900 mb-1">Uang (Rp per Hari)</label>
                        <input type="number" name="standar_fidyah_uang" value="<%= event.standar_fidyah_uang %>" required class="w-full border border-purple-300 rounded-lg p-2.5 bg-white font-bold text-purple-800">
                    </div>
                </div>
            </div>
            
            <!-- KETETAPAN ZAKAT MAL -->
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                <h3 class="font-bold text-blue-900 text-sm uppercase mb-2">Zakat Mal</h3>
                <div>
                    <label class="block text-xs font-bold text-blue-800">Nisab Zakat Mal (Rp)</label>
                    <input type="number" name="nisab_zakat_mal" value="<%= event.nisab_zakat_mal %>" required class="w-full border border-blue-300 rounded-lg p-2.5 bg-white font-bold text-blue-800">
                    <p class="text-[10px] text-blue-600 mt-1">Nilai harta minimal untuk wajib zakat mal (Standar 85 gram emas).</p>
                </div>
            </div>

            <div class="flex gap-3 pt-4">
                <a href="/admin/zakat/laporan" class="w-1/3 py-3 text-center bg-gray-500 hover:bg-gray-600 text-white font-bold rounded-lg shadow-md transition text-sm flex items-center justify-center">
                    Batal
                </a>
                <button type="submit" class="w-2/3 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-lg shadow-md transition text-sm">
                    Simpan Perubahan &rarr;
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL POPUP NOTIFIKASI (SUKSES / GAGAL) -->
<!-- ========================================== -->
<div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
        <div class="text-center">
            <!-- Ikon Status Dinamis -->
            <div id="notifIconSuccess" class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            </div>
            <div id="notifIconError" class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4 hidden">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>

            <h3 id="notifTitle" class="text-lg font-bold text-gray-800 mb-1">Notifikasi</h3>
            <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan notifikasi di sini...</p>
            
            <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-amber-600 hover:bg-amber-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>

<!-- SCRIPT VALIDASI DAN MODAL -->
<script>
    function toggleCustom(target) {
        if (target === 'ketua') {
            const select = document.getElementById('select_jabatan_ketua');
            const input = document.getElementById('input_jabatan_ketua');
            if (select.value === 'Custom') {
                input.classList.remove('hidden');
                input.value = '';
                input.focus();
            } else {
                input.classList.add('hidden');
                input.value = select.value;
            }
        } else if (target === 'pendamping') {
            const select = document.getElementById('select_sub_ketua');
            const input = document.getElementById('input_sub_ketua');
            if (select.value === 'Custom') {
                input.classList.remove('hidden');
                input.value = '';
                input.focus();
            } else {
                input.classList.add('hidden');
                input.value = select.value;
            }
        }
    }

    function showNotification(isSuccess, message) {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        const iconSuccess = document.getElementById('notifIconSuccess');
        const iconError = document.getElementById('notifIconError');
        const title = document.getElementById('notifTitle');
        const msg = document.getElementById('notifMessage');

        msg.innerText = message;

        if (isSuccess) {
            title.innerText = "Berhasil!";
            iconSuccess.classList.remove('hidden');
            iconError.classList.add('hidden');
        } else {
            title.innerText = "Perhatian!";
            iconError.classList.remove('hidden');
            iconSuccess.classList.add('hidden');
        }

        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeNotificationModal() {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    // VALIDASI FORM EDIT AGENDA
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[action*="/admin/zakat/laporan/edit/"]');
        
        if (form) {
            form.addEventListener('submit', function(e) {
                const namaEvent = document.getElementById('nama_event');
                const namaKetua = document.getElementById('nama_ketua');
                const namaSubKetua = document.getElementById('nama_sub_ketua');

                if (!namaEvent.value.trim()) {
                    e.preventDefault();
                    showNotification(false, 'Nama Periode / Agenda zakat wajib diisi!');
                    namaEvent.focus();
                    return;
                }

                if (!namaKetua.value.trim()) {
                    e.preventDefault();
                    showNotification(false, 'Nama Lengkap Ketua / Penandatangan 1 wajib diisi!');
                    namaKetua.closest('details').open = true;
                    namaKetua.focus();
                    return;
                }

                if (!namaSubKetua.value.trim()) {
                    e.preventDefault();
                    showNotification(false, 'Nama Lengkap Pendamping / Penandatangan 2 wajib diisi!');
                    namaSubKetua.closest('details').open = true;
                    namaSubKetua.focus();
                    return;
                }
            });
        }
    });

    <% if (typeof success !== 'undefined' && success) { %>
        showNotification(true, 'Agenda dan ketentuan zakat berhasil diperbarui!');
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        showNotification(false, '<%= error %>');
    <% } %>
</script>

<%- include('../partials/footer') %>