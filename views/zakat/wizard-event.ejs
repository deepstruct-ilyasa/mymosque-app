<%- include('../partials/header') %>

<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 w-full mt-4">
        <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-800 text-center mb-1">Setup Periode Zakat Baru</h2>
        <p class="text-gray-500 text-sm text-center mb-6">Tentukan nama agenda serta standar ketetapan besaran Zakat Fitrah dan Fidyah untuk periode ini.</p>
        
        <form action="/admin/zakat/wizard-event" method="POST" enctype="multipart/form-data" class="space-y-4">
            
            <!-- INFORMASI UTAMA AGENDA -->
            <div class="space-y-4 bg-gray-50 p-4 rounded-xl border border-gray-200">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nama Periode / Agenda</label>
                    <input type="text" id="nama_event" name="nama_event" required placeholder="Contoh: Zakat Fitrah & Fidyah 1447 H / 2026" class="w-full border border-gray-300 rounded-lg p-3 bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Keterangan / Deskripsi</label>
                    <input type="text" name="deskripsi" placeholder="Contoh: Ketetapan berdasarkan hasil rapat pengurus masjid" class="w-full border border-gray-300 rounded-lg p-3 bg-white focus:ring-2 focus:ring-emerald-500 outline-none">
                </div>
            </div>

            <!-- COLLAPSE 1: KOP SURAT & LEMBAGA -->
            <details class="bg-gray-50 border border-gray-200 rounded-xl p-4 group">
                <summary class="font-semibold text-sm text-gray-700 cursor-pointer flex justify-between items-center select-none">
                    <span class="flex items-center gap-2">📂 Identitas Lembaga & Kop Surat (Arsip Laporan)</span>
                    <span class="text-xs text-emerald-600 font-bold group-open:hidden">[ Buka ]</span>
                    <span class="text-xs text-red-600 font-bold hidden group-open:inline">[ Tutup ]</span>
                </summary>
                
                <div class="mt-4 pt-4 border-t border-gray-200 space-y-3 bg-white p-3 rounded-lg">
                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Masjid</label>
                        <input type="text" name="nama_lembaga" value="<%= typeof defaultNama !== 'undefined' ? defaultNama : '' %>" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: MASJID AL-MUHARRAR">
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Sub Lembaga / Kepanitiaan</label>
                        <input type="text" name="sub_lembaga" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: PANITIA PENERIMAAN & PENGELOLAAN ZAKAT">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">No. Telepon / Kontak</label>
                            <input type="text" name="telepon" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="(0274) XXXXXX">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Upload Logo Lembaga</label> 
                            <div class="flex items-center gap-3 mb-2">
                                <% if (typeof defaultLogo !== 'undefined' && defaultLogo) { %>
                                    <div id="preview-container" class="w-12 h-12 border border-gray-200 rounded-lg bg-gray-50 flex items-center justify-center overflow-hidden flex-shrink-0">
                                        <img id="logo-preview" src="/uploads/<%= defaultLogo %>" alt="Preview Logo" class="w-full h-full object-contain">
                                    </div>
                                    <span id="preview-text" class="text-[11px] text-gray-500 italic">Menggunakan logo default aplikasi.</span>
                                    <input type="hidden" name="default_logo" value="<%= defaultLogo %>">
                                <% } else { %>
                                    <div id="preview-container" class="hidden w-12 h-12 border border-gray-200 rounded-lg bg-gray-50 flex items-center justify-center overflow-hidden flex-shrink-0">
                                        <img id="logo-preview" src="#" alt="Preview Logo" class="w-full h-full object-contain">
                                    </div>
                                    <span id="preview-text" class="text-[11px] text-gray-400 italic">Belum ada logo dipilih.</span>
                                <% } %>
                            </div>
                            <input type="file" id="input-logo" name="logo" accept="image/*" class="w-full border border-gray-300 rounded-lg p-2 text-xs bg-gray-50" onchange="previewLogo(event)">
                            <p class="text-[10px] text-gray-400 mt-1">Biarkan kosong jika ingin menggunakan logo default aplikasi.</p>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Alamat Sekretariat</label>
                        <textarea name="alamat" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" rows="2" placeholder="Jl. Raya Masjid No. 01..."><%= typeof defaultAlamat !== 'undefined' ? defaultAlamat : '' %></textarea>
                    </div>
                </div>
            </details>

            <!-- COLLAPSE 2: PEJABAT PENANDATANGAN -->
            <details class="bg-gray-50 border border-gray-200 rounded-xl p-4 group">
                <summary class="font-semibold text-sm text-gray-700 cursor-pointer flex justify-between items-center select-none">
                    <span class="flex items-center gap-2">✍️ Pejabat Penandatangan Laporan</span>
                    <span class="text-xs text-emerald-600 font-bold group-open:hidden">[ Buka ]</span>
                    <span class="text-xs text-red-600 font-bold hidden group-open:inline">[ Tutup ]</span>
                </summary>
                
                <div class="mt-4 pt-4 border-t border-gray-200 space-y-3 bg-white p-3 rounded-lg">
                    
                    <!-- JABATAN & NAMA KETUA -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Jabatan Utama (Penandatangan 1)</label>
                            <select id="select_jabatan_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm bg-white" onchange="toggleCustom('ketua')">
                                <option value="Ketua Panitia">Ketua Panitia</option>
                                <option value="Ketua Takmir">Ketua Takmir</option>
                                <option value="Custom">Lainnya (Custom)...</option>
                            </select>
                            <input type="text" id="input_jabatan_ketua" name="ketua" value="Ketua Panitia" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm mt-2 hidden" placeholder="Ketik nama jabatan...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Lengkap Ketua</label>
                            <input type="text" id="nama_ketua" name="nama_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: Ust. Ahmad Sucipto">
                        </div>
                    </div>

                    <!-- JABATAN & NAMA PENDAMPING -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 pt-2">
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Jabatan Pendamping (Penandatangan 2)</label>
                            <select id="select_sub_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm bg-white" onchange="toggleCustom('pendamping')">
                                <option value="Bendahara">Bendahara</option>
                                <option value="Sekretaris">Sekretaris</option>
                                <option value="Custom">Lainnya (Custom)...</option>
                            </select>
                            <input type="text" id="input_sub_ketua" name="sub_ketua" value="Bendahara" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm mt-2 hidden" placeholder="Ketik nama jabatan...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase mb-1 text-gray-600">Nama Lengkap Pendamping</label>
                            <input type="text" id="nama_sub_ketua" name="nama_sub_ketua" class="w-full border border-gray-300 rounded-lg p-2.5 text-sm" placeholder="Contoh: Bpk. Budi S.Pd">
                        </div>
                    </div>
                </div>
            </details>

            <!-- KETETAPAN STANDAR ZAKAT FITRAH -->
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ketentuan Standar Zakat Fitrah</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-emerald-50 p-4 rounded-xl border border-emerald-100">
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 mb-1">Beras (Kg per Jiwa)</label>
                        <input type="number" step="0.001" name="standar_fitrah_beras" value="2.5" required class="w-full border border-emerald-300 rounded-lg p-2.5 bg-white font-bold text-emerald-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-emerald-900 mb-1">Uang (Rp per Jiwa)</label>
                        <input type="text" id="input_fitrah_uang" value="<%= typeof event !== 'undefined' ? event.standar_fitrah_uang : '40000' %>" placeholder="Contoh: 40.000" required class="w-full border border-emerald-300 rounded-lg p-2.5 bg-white font-bold text-emerald-800 outline-none">
                        <input type="hidden" name="standar_fitrah_uang" id="hidden_fitrah_uang" value="<%= typeof event !== 'undefined' ? event.standar_fitrah_uang : '40000' %>">
                    </div>
                </div>
            </div>

            <!-- KETETAPAN STANDAR FIDYAH -->
            <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Ketentuan Standar Fidyah</label>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-purple-50 p-4 rounded-xl border border-purple-100">
                    <div>
                        <label class="block text-xs font-bold text-purple-900 mb-1">Beras (Kg per Hari)</label>
                        <input type="number" step="0.1" name="standar_fidyah_beras" value="0.6" required class="w-full border border-purple-300 rounded-lg p-2.5 bg-white font-bold text-purple-800">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-purple-900 mb-1">Uang (Rp per Hari)</label>
                        <input type="text" id="input_fidyah_uang" value="<%= typeof event !== 'undefined' ? event.standar_fidyah_uang : '30000' %>" placeholder="Contoh: 30.000" required class="w-full border border-purple-300 rounded-lg p-2.5 bg-white font-bold text-purple-800 outline-none">
                        <input type="hidden" name="standar_fidyah_uang" id="hidden_fidyah_uang" value="<%= typeof event !== 'undefined' ? event.standar_fidyah_uang : '30000' %>">
                    </div>
                </div>
            </div>
            
            <!-- KETETAPAN ZAKAT MAL -->
            <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
                <h3 class="font-bold text-blue-900 text-sm uppercase mb-2">Zakat Mal</h3>
                <div>
                    <label class="block text-xs font-bold text-blue-800">Nisab Zakat Mal (Rp)</label>
                    <input type="text" id="input_nisab_mal" value="<%= typeof event !== 'undefined' ? event.nisab_zakat_mal : '85000000' %>" required class="w-full border border-blue-300 rounded-lg p-2.5 bg-white font-bold text-blue-800 outline-none">
                    <input type="hidden" name="nisab_zakat_mal" id="hidden_nisab_mal" value="<%= typeof event !== 'undefined' ? event.nisab_zakat_mal : '85000000' %>">
                    <p class="text-[10px] text-blue-600 mt-1">Nilai harta minimal untuk wajib zakat mal (Standar 85 gram emas).</p>
                </div>
            </div>

            <button type="submit" class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-lg shadow-md transition-colors text-base mt-4">
                Simpan & Mulai Buka Periode &rarr;
            </button>
        </form>
    </div>
</div>

<!-- MODAL POPUP NOTIFIKASI -->
<div id="notificationModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm hidden">
    <div class="bg-white rounded-2xl p-6 max-w-sm w-full mx-4 shadow-2xl transform transition-all scale-95 opacity-0" id="notifModalContainer">
        <div class="text-center">
            <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-gray-800 mb-1">Perhatian</h3>
            <p id="notifMessage" class="text-sm text-gray-500 mb-6">Pesan error...</p>
            <button type="button" onclick="closeNotificationModal()" class="w-full px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-sm font-semibold transition-colors shadow-sm">
                OK, Mengerti
            </button>
        </div>
    </div>
</div>

<script>
    function toggleCustom(target) {
        if (target === 'ketua') {
            const select = document.getElementById('select_jabatan_ketua');
            const input = document.getElementById('input_jabatan_ketua');
            if (select.value === 'Custom') {
                input.classList.remove('hidden');
                input.value = '';
                input.focus();
            } else {
                input.classList.add('hidden');
                input.value = select.value;
            }
        } else if (target === 'pendamping') {
            const select = document.getElementById('select_sub_ketua');
            const input = document.getElementById('input_sub_ketua');
            if (select.value === 'Custom') {
                input.classList.remove('hidden');
                input.value = '';
                input.focus();
            } else {
                input.classList.add('hidden');
                input.value = select.value;
            }
        }
    }

    function previewLogo(event) {
        const input = event.target;
        const previewContainer = document.getElementById('preview-container');
        const previewImage = document.getElementById('logo-preview');
        const previewText = document.getElementById('preview-text');

        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove('hidden');
                previewText.textContent = "Pratinjau logo terpilih:";
            }
            reader.readAsDataURL(input.files[0]);
        } else {
            previewContainer.classList.add('hidden');
            previewText.textContent = "Belum ada logo dipilih.";
        }
    }

    function showNotification(message) {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        const msg = document.getElementById('notifMessage');

        msg.innerText = message;
        modal.classList.remove('hidden');
        setTimeout(() => {
            container.classList.remove('scale-95', 'opacity-0');
            container.classList.add('scale-100', 'opacity-100');
        }, 10);
    }

    function closeNotificationModal() {
        const modal = document.getElementById('notificationModal');
        const container = document.getElementById('notifModalContainer');
        container.classList.remove('scale-100', 'opacity-100');
        container.classList.add('scale-95', 'opacity-0');
        setTimeout(() => {
            modal.classList.add('hidden');
        }, 200);
    }

    // VALIDASI FORM SEBELUM DISUBMIT
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[action="/admin/zakat/wizard-event"]');
        
        if (form) {
            form.addEventListener('submit', function(e) {
                const namaEvent = document.getElementById('nama_event');
                const namaKetua = document.getElementById('nama_ketua');
                const namaSubKetua = document.getElementById('nama_sub_ketua');

                if (!namaEvent.value.trim()) {
                    e.preventDefault();
                    showNotification('Nama Periode / Agenda zakat wajib diisi terlebih dahulu!');
                    namaEvent.focus();
                    return;
                }

                if (!namaKetua.value.trim()) {
                    e.preventDefault();
                    showNotification('Nama Lengkap Ketua / Penandatangan 1 wajib diisi!');
                    namaKetua.closest('details').open = true;
                    namaKetua.focus();
                    return;
                }

                if (!namaSubKetua.value.trim()) {
                    e.preventDefault();
                    showNotification('Nama Lengkap Pendamping / Penandatangan 2 wajib diisi!');
                    namaSubKetua.closest('details').open = true;
                    namaSubKetua.focus();
                    return;
                }
            });
        }
    });

    <% if (typeof error !== 'undefined' && error) { %>
        showNotification('<%= error %>');
    <% } %>
</script>

<%- include('../partials/footer') %>